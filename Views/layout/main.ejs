<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= locals.titulo ? titulo + ' | Zirim' : 'Zirim' %></title>

    <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
    <link rel="stylesheet" href="/css/main.css">
    <link rel="stylesheet" href="/css/utilities.css">
    <script src="/js/core/ready.js"></script>

    <% if (locals.pageStyles && Array.isArray(pageStyles)) { %>
        <% pageStyles.forEach(function(styleSheet) { %>
            <link rel="stylesheet" href="/css/pages/<%= styleSheet %>.css">
        <% }); %>
    <% } %>
</head>

<body hx-boost="true" hx-target="#main-content" hx-push-url="true" hx-swap="innerHTML">
    <div id="notification-container"></div>
    <%- include('../pages/partials/header') %>
    <main id="main-content">
        <%- include(page) %>
    </main>
    <script src="https://unpkg.com/htmx.org@2.0.4"></script>
    <script src="/js/main.js"></script>
</body>
</html>