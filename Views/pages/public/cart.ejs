<div class="cart-container" style="max-width: 800px; margin: 2rem auto; padding: 20px;">
    <h1>Meu Carrinho</h1>
    <div id="cart-items">
        <p>Seu carrinho está vazio.</p>
    </div>
    <div class="cart-summary" style="margin-top: 20px; border-top: 1px solid #ddd; padding-top: 20px;">
        <h3>Total: R$ <span id="cart-total">0,00</span></h3>
        <button class="btn" style="padding: 10px 20px; background-color: #D2042D; color: white; border: none; border-radius: 5px; cursor: pointer;">Finalizar Compra</button>
    </div>
</div>