<link rel="stylesheet" href="/css/pages/home.css">

<% const currentBanner = (typeof banner !=='undefined' && banner) ? banner : null;

  const isBannerActive= !currentBanner || currentBanner.ativo !== false;
  const isButtonEnabled=!currentBanner || currentBanner.exibirBotao !==false;
  const bannerImage = currentBanner?.imageUrl; 
  const defaultBg='https://images.unsplash.com/photo-1441984904996-e0b6ba687e04?ixlib=rb-1.2.1&auto=format&fit=crop&w=1950&q=80';
  const heroBg=bannerImage ? ('/image/' + bannerImage) : defaultBg; const bannerTitle=currentBanner?.title || '' ;
  const bannerDesc=currentBanner?.description || '' ;
  const hasText=Boolean(bannerTitle.trim() || bannerDesc.trim());
  const btnLink=currentBanner?.link || '/products';
  const btnText = currentBanner?.textoBotao || 'Ver Coleção' ; %>

  <div class="home-container">

    <% if (isBannerActive) { %>
      <section 
        class="hero <%= (hasText || isButtonEnabled) ? 'hero-with-overlay' : '' %> preload-bg skeleton-loader"
        data-bg="<%= heroBg %>"
      >
        <% if (bannerTitle.trim()) { %>
          <h1>
            <%= bannerTitle %>
          </h1>
          <% } %>

            <% if (bannerDesc.trim()) { %>
              <p>
                <%= bannerDesc %>
              </p>
              <% } %>

                <% if (isButtonEnabled) { %>
                  <a href="<%= btnLink %>" class="btn">
                    <%= btnText %>
                  </a>
                  <% } else if (btnLink) { %>
                    <a href="<%= btnLink %>" class="hero-link-overlay" aria-label="Acessar link do banner"></a>
                    <% } %>
      </section>
      <% } %>

        
      
      <section class="categories">
          <div class="categories-wrapper">
            <% 
              const defaultCategories = [
                { title: 'Moda', link: '/products?category=todos', imageUrl: 'https://images.unsplash.com/photo-1460353581641-37baddab0fa2?auto=format&fit=crop&w=400&q=80' },
                { title: 'Calçados', link: '/products?category=calcados', imageUrl: 'https://images.unsplash.com/photo-1542291026-7eec264c27ff?ixlib=rb-1.2.1&auto=format&fit=crop&w=800&q=80' }
              ];
              const categoriesList = (currentBanner?.categories && currentBanner.categories.length > 0)
                ? currentBanner.categories
                : defaultCategories;
            %>

            <% categoriesList.forEach(category => { 
                const catImg = category.imageUrl?.startsWith('http') 
                  ? category.imageUrl 
                  : ('/image/' + category.imageUrl);
            %>
              <div class="category-card">
                <img 
                  src="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 400 300'%3E%3C/svg%3E" 
                  data-src="<%= catImg %>" 
                  alt="<%= category.title %>"
                  width="400"
                  height="300"
                  class="preload-img skeleton-loader"
                >
                <div class="category-card-content">
                  <h3><%= category.title %></h3>
                  <a href="<%= category.link || '/products' %>">Explorar</a>
                </div>
              </div>
            <% }) %>

          </div>
        </section>


        <section class="featured-products">
          <h2>Destaque</h2>

          <% if (products && products.length> 0) { %>
            <div class="featured-products-wrapper">
              <% products.forEach(product=> { %>
                <div class="product-card">
                  <% let imgSrc='https://via.placeholder.com/400x400' ; if (Array.isArray(product.variacoes?.[0]?.imagens)
                    && product.variacoes[0].imagens.length > 0) {

                    imgSrc = '/image/' + product.variacoes[0].imagens[0];

                    }

                    %>
                    <img 
                      src="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 400 400'%3E%3C/svg%3E" 
                      data-src="<%= imgSrc %>" 
                      alt="<%= product.nome %>"
                      width="400"
                      height="400"
                      class="preload-img skeleton-loader"
                    >
                    <h3>
                      <%= product.nome %>
                    </h3>
                    <a href="/product/<%= product._id %>" class="view-details-btn">Detalhes</a>
                </div>
                <% }) %>
            </div>
            <% } else { %>
              <p class="no-products-msg">Novidades chegando em breve!</p>
              <% } %>
        </section>
  </div>

  <style>
    .category-card,
    .product-card {
      overflow: hidden;
    }

    .preload-img {
      display: block;
      width: 100%;
      height: auto;
      object-fit: cover;
      filter: blur(8px);
      transform: scale(1.02);
      opacity: 0.85;
      transition: filter 0.25s cubic-bezier(0.4, 0, 0.2, 1),
                  transform 0.25s cubic-bezier(0.4, 0, 0.2, 1),
                  opacity 0.25s ease-out;
      will-change: filter, transform, opacity;
    }

    .category-card img.preload-img {
      aspect-ratio: 4 / 3;
    }

    .product-card img.preload-img {
      aspect-ratio: 1 / 1;
    }

    .preload-img.loaded {
      filter: blur(0);
      transform: scale(1);
      opacity: 1;
    }

    .preload-bg {
      min-height: 290px;
      transition: background-image 0.5s ease-in-out;
    }

    .preload-bg.skeleton-loader,
    .skeleton-loader {
      background-color: #f1f5f9;
      background-image: linear-gradient(
        135deg,
        #f1f5f9 0%,
        #f1f5f9 25%,
        #e2e8f0 38%,
        #cbd5e1 50%,
        #e2e8f0 62%,
        #f1f5f9 75%,
        #f1f5f9 100%
      );
      background-size: 300% 300%;
      background-repeat: no-repeat;
      animation: skeleton-loading-diagonal 2s infinite ease-in-out;
    }

    @keyframes skeleton-loading-diagonal {
      0% {
        background-position: 100% 100%;
      }
      100% {
        background-position: 0% 0%;
      }
    }
  </style>

  <script>
    (() => {
      const preloadImageWithFetch = async (img) => {
        const src = img.getAttribute('data-src');
        if (!src || img.dataset.loading) return;
        img.dataset.loading = 'true';

        try {
          const response = await fetch(src);
          if (!response.ok) throw new Error(`Status HTTP: ${response.status}`);
          
          const blob = await response.blob();
          const objectUrl = URL.createObjectURL(blob);

          img.onload = () => {
            img.classList.remove('skeleton-loader');
            img.classList.add('loaded');
          };
          img.src = objectUrl;

          if (img.complete) {
            img.classList.remove('skeleton-loader');
            img.classList.add('loaded');
          }
        } catch (error) {
          console.warn('Falha no pré-carregamento com fetch. Aplicando fallback direto:', error);
          img.src = src;
          img.classList.remove('skeleton-loader');
          img.classList.add('loaded');
        }
      };

      const preloadBgWithFetch = async (el) => {
        const src = el.getAttribute('data-bg');
        if (!src || el.dataset.loading) return;
        el.dataset.loading = 'true';

        try {
          const response = await fetch(src);
          if (!response.ok) throw new Error(`Status HTTP: ${response.status}`);

          const blob = await response.blob();
          const objectUrl = URL.createObjectURL(blob);

          const tempImg = new Image();
          tempImg.onload = () => {
            el.style.backgroundImage = `url('${objectUrl}')`;
            el.classList.remove('skeleton-loader');
            el.classList.add('loaded');
          };
          tempImg.src = objectUrl;

          if (tempImg.complete) {
            el.style.backgroundImage = `url('${objectUrl}')`;
            el.classList.remove('skeleton-loader');
            el.classList.add('loaded');
          }
        } catch (error) {
          console.warn('Falha no pré-carregamento do hero banner. Aplicando fallback direto:', error);
          el.style.backgroundImage = `url('${src}')`;
          el.classList.remove('skeleton-loader');
          el.classList.add('loaded');
        }
      };

      const initPreload = () => {
        const targets = document.querySelectorAll(
          'img[data-src]:not([data-loading="true"]), [data-bg]:not([data-loading="true"])'
        );

        const processTarget = (el) => {
          if (el.tagName === 'IMG') {
            preloadImageWithFetch(el);
          } else {
            preloadBgWithFetch(el);
          }
        };

        if ('IntersectionObserver' in window) {
          const observer = new IntersectionObserver((entries, obs) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                obs.unobserve(entry.target);
                processTarget(entry.target);
              }
            });
          }, { rootMargin: '100px 0px' });

          targets.forEach((target) => observer.observe(target));
        } else {
          targets.forEach(processTarget);
        }
      };

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initPreload);
      } else {
        initPreload();
      }

      document.addEventListener('htmx:afterSwap', initPreload);
    })();
  </script>