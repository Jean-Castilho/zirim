<div class="contact-container u-max-width-600px-margin-0-auto-paddin-00083b">
    <h1 class="u-margin-10px-20px-20px">Entre em Contato</h1>
    <form class="u-display-flex-flex-direction-column-gap-15px" action="/contact" method="POST">
        <input class="u-padding-10px" type="text" name="name" placeholder="Seu Nome" required>
        <input class="u-padding-10px" type="email" name="email" placeholder="Seu E-mail" required>
        <textarea class="u-padding-10px" name="message" placeholder="Sua Mensagem" rows="5" required></textarea>
        <button type="submit" class="btn u-padding-10px-background-color-d2042d-625c78">Enviar Mensagem</button>
    </form>
</div>