<div class="contact-container" style="max-width: 600px; margin: 2rem auto; padding: 20px;">
    <h1>Entre em Contato</h1>
    <form action="/contact" method="POST" style="display: flex; flex-direction: column; gap: 15px;">
        <input type="text" name="name" placeholder="Seu Nome" required style="padding: 10px;">
        <input type="email" name="email" placeholder="Seu E-mail" required style="padding: 10px;">
        <textarea name="message" placeholder="Sua Mensagem" rows="5" required style="padding: 10px;"></textarea>
        <button type="submit" class="btn" style="padding: 10px; background-color: #D2042D; color: white; border: none; border-radius: 5px; cursor: pointer;">Enviar Mensagem</button>
    </form>
</div>