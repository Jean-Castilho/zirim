<link rel="stylesheet" href="/css/pages/products.css">
<div class="products-container">

  <div class="filters">

    <div class="filter-search">

      <label for="search-input">Buscar</label>

      <input type="search" id="search-input" placeholder="Digite seu produto..." autocomplete="off" />

      <button id="search-button" class="search-button" title="Pesquisar">
        <i class="material-icons" translate="no">search</i>
      </button>


      <button id="filter-dropdown-button" class="filter-dropdown-button search-button" type="button" title="Filtros">
        <i class="material-icons" translate="no">filter_list</i>
      </button>

      <div id="filter-dropdown-content" class="filter-dropdown-content">
        <a href="/products" class="active">Todos</a>
        <a href="/products?category=feminino">Feminino</a>
        <a href="/products?category=masculino">Masculino</a>
        <a href="/products?category=calcados">Calçados</a>
        <a href="/products?category=acessorios">Acessórios</a>
        <a href="/products?category=eletronicos">Eletrônicos</a>
      </div>

    </div>

  </div>

  <div class="products-grid">
    <% if (products && products.length> 0) { %>
      <% products.forEach(product=> { %>
        <div class="product-card">

          <div class="product-image-wrapper">

            <img src="<%= product.variacoes[0].imagens[0] && product.variacoes[0].imagens.length > 0 ? '/image/' + product.variacoes[0].imagens[0] : 'https://via.placeholder.com/40' %>" alt="<%= product.nome %>">

            <button class="btn-favorite event-Favorit" data-product-id="<%= product._id %>" data-is-favorited="false" title="Favoritar">
              <i class="material-icons favorite-icon" translate="no">favorite_border</i>
            </button>

          </div>

          <div class="product-details">
            <a href="/product/<%= product._id %>" class="btn-view-details">
              Ver Detalhes
            </a>
          </div>
        </div>
        <% }) %>
          <% } else { %>
            <div class="empty-state">
              <i class="material-icons" translate="no">sentiment_dissatisfied</i>
              <p>Nenhum produto encontrado.</p>
            </div>
            <% } %>
  </div>
</div>

<script src="/js/search.js"></script>
<script src="/js/favorited.js"></script>