<style>
  /* Base Layout */
  .product-details-page {
    padding: 40px 20px;
    max-width: 1400px;
    margin: 0 auto;
  }

  .product-details-container {
    display: grid;
    margin: 0px 80px;
    grid-template-columns: 1fr 1fr;
    justify-items: center;
  }

  .product-gallery {
    display: flex;
    flex-direction: column;
    width: 75%;
    gap: 20px;
  }

  .product-info {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  /* Navigation & Typography */
  .breadcrumb {
    font-size: 0.9em;
    color: #666;
  }

  .breadcrumb a {
    color: var(--cor-secundaria);
    text-decoration: none;
    font-weight: 500;
  }

  .product-title {
    font-size: 1.8rem;
    line-height: 1.0;
    color: var(--cor-primaria);
    margin: 0;
  }

  /* Price Section */
  .price-section {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding-bottom: 10px;
    border-bottom: 1px solid #eee;
  }

  .price {
    display: flex;
    align-items: baseline;
    gap: 4px;
  }

  .currency {
    font-size: 1.2rem;
    color: var(--cor-secundaria);
    font-weight: 600;
  }

  .amount {
    font-size: 2.2em;
    font-weight: 700;
    color: var(--cor-secundaria);
  }

  .price-note {
    font-size: 0.85rem;
    color: #999;
    margin: 0;
  }

  /* Specifications */
  .specifications {
    padding: 10px;
    background: #f9f9f9;
    border-radius: 12px;
  }

  .specifications h3 {
    margin: 0 0 12px 0;
    font-size: 1rem;
    color: var(--cor-primaria);
  }

  .spec-item {
    display: flex;
    justify-content: space-between;
    padding: 7px 0;
    border-bottom: 1px solid #e0e0e0;
  }

  .spec-label {
    font-weight: 600;
    color: #666;
  }

  /* Selection & Controls */
  .selectors {
    display: flex;
    justify-content: space-between;
    gap: 20px;
  }

  .variation-section {
    display: flex;
    flex-direction: column;
    margin-bottom: 12px;
    gap: 8px;
  }

  .quantity-section {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .quantity-control {
    display: flex;
    align-items: center;
    border: 1px solid #ddd;
    border-radius: 8px;
    width: fit-content;
  }

  .qty-btn {
    width: 40px;
    height: 40px;
    border: none;
    background: transparent;
    cursor: pointer;
    font-size: 1.2rem;
  }

  .quantity-control input {
    width: 60px;
    height: 40px;
    border: none;
    text-align: center;
    font-size: 1rem;
    font-weight: 600;
  }

  /* Buttons */
  .action-buttons {
    display: flex;
    gap: 12px;
  }

  .btn-primary, .btn-secondary {
    flex: 1;
    padding: 16px 24px;
    border: none;
    border-radius: 8px;
    font-size: 1rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s ease;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    text-transform: uppercase;
  }

  .btn-primary {
    background: var(--cor-secundaria);
    color: white;
  }

  .btn-primary:hover:not(:disabled) {
    background: var(--cor-destaque);
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(225, 7, 50, 0.3);
  }

  .btn-secondary {
    background: white;
    color: var(--cor-secundaria);
    border: 2px solid var(--cor-secundaria);
  }

  .btn-secondary:hover {
    background: var(--cor-secundaria);
    color: white;
  }

  /* Guarantee Section */
  .guarantee-section {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    padding-top: 20px;
    border-top: 1px solid #eee;
  }

  .guarantee-item {
    display: flex;
    gap: 12px;
    align-items: flex-start;
  }

  .guarantee-item i {
    color: var(--cor-secundaria);
    font-size: 24px;
  }

  /* Description & Related */
  .expanded-description {
    background: #f9f9f9;
    padding: 40px 60px;
    border-radius: 16px;
    margin-top: 40px;
  }

  .related-products {
    margin-top: 40px;
  }

  .related-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 24px;
  }

  .related-card {
    background: white;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    transition: transform 0.3s ease;
  }

  .related-card img {
    width: 100%;
    height: 240px;
    object-fit: cover;
  }

  .stock-badge {
    position: absolute;
    top: 20px;
    right: 5px;
    padding: 8px 16px;
    background: #4CAF50;
    color: white;
    border-radius: 8px;
  }

  .pill-option.selected {
    border-color: var(--cor-secundaria) !important;
    background-color: var(--cor-primaria) !important;
    color: white !important;
    transform: translateY(-3px) scale(1.05);
    box-shadow: 0 6px 15px rgba(0, 0, 0, 0.2);
  }

  .pill-option {
    cursor: pointer;
    padding: 10px 20px;
    border: 2px solid var(--cor-borda);
    border-radius: 12px;
    transition: all 0.3s cubic-bezier(0.23, 1, 0.32, 1);
    user-select: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-weight: 500;
    background: white;
  }

  .pill-option:hover:not(.disabled):not(.selected) {
    border-color: var(--cor-secundaria);
    color: var(--cor-secundaria);
    transform: translateY(-1px);
  }

  .pill-option.disabled {
    opacity: 0.25;
    cursor: not-allowed;
    text-decoration: line-through;
    filter: grayscale(1);
    pointer-events: none;
  }

  .pill-option-color {
    width: 48px;
    height: 48px;
    padding: 0;
    border-radius: 50%;
    overflow: hidden;
    position: relative;
    border: 2px solid transparent;
  }

  .pill-option-color:hover:not(.selected) {
    transform: scale(1.15);
  }

  .pill-option-color.selected .color-swatch {
    border-color: var(--cor-secundaria) !important;
    background-color: transparent !important;
    padding: 3px;
  }

  .color-swatch {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    border: 1px solid rgba(0,0,0,0.1);
    transition: transform 0.3s ease;
  }

  .main-image-container {
    width: 100%;
    height: 500px;
    background-color: #f8f8f8;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    border-radius: 16px;
    position: relative;
  }

  .main-image {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
    transition: opacity 0.5s ease, transform 0.5s ease;
  }

  .gallery-thumbnails {
    display: flex;
    gap: 12px;
    margin-top: 15px;
    overflow-x: auto;
    padding: 5px 2px;
    scrollbar-width: thin;
  }

  .thumbnail {
    width: 90px;
    height: 90px;
    flex-shrink: 0;
    border-radius: 8px;
    overflow: hidden;
    cursor: pointer;
    border: 2px solid transparent;
    transition: all 0.2s ease;
    background: #fff;
  }

  .thumbnail img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .thumbnail.active {
    border-color: var(--cor-secundaria);
    transform: scale(1.05);
    box-shadow: 0 4px 10px rgba(0,0,0,0.1);
  }

  .qty-btn:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  #addToCartButton:not(:disabled):active {
    transform: scale(0.98);
  }

  .validation-error {
    color: var(--cor-secundaria);
    font-size: 0.85rem;
    margin-top: 5px;
    font-weight: 600;
  }

  /* Animação de Opacidade/Skeleton */
  .skeleton {
    background-color: #eee;
    background-image: linear-gradient(90deg, #eee, #f5f5f5, #eee);
    background-size: 200px 100%;
    background-repeat: no-repeat;
    display: inline-block;
    line-height: 1;
    width: 100%;
    animation: skeleton-loading 1.5s infinite linear;
    border-radius: 4px;
    color: transparent !important;
  }

  @keyframes skeleton-loading {
    0% { background-position: -200px 0; }
    100% { background-position: calc(200px + 100%) 0; }
  }

  /* Responsive Adjustments */
  @media (max-width: 1024px) {
    .product-details-container {
      grid-template-columns: 1fr;
      margin: 0;
    }
  }

  @media (max-width: 768px) {
    .action-buttons {
      flex-direction: column;
    }
    .guarantee-section {
      grid-template-columns: 1fr;
    }
    .product-gallery {
      width: 100%;
    }
  }

  .product-not-found {
    padding: 60px 20px;
    text-align: center;
    color: #777;
  }
</style>

<section class="product-details-page">
    <% if (!product) { %>
      <div class="product-not-found">
        <h2>Produto não encontrado</h2>
        <p>Verifique se o link está correto ou tente novamente mais tarde.</p>
        <a href="/products" class="btn-back-products">Voltar para produtos</a>
      </div>
      <% } else { %>
        <div class="product-details-container">
          <!-- Galeria de Imagens -->
          <div class="product-gallery">
            
            <div class="main-image-container skeleton"> 
              <img id="mainImage" 
                   src="/img/placeholder-product.webp"
                   alt="Carregando..."
                   class="main-image" style="opacity: 0; transition: opacity 0.5s ease;">
              <span class="stock-badge skeleton" id="stockBadgeDisplay">Carregando</span>
            </div>

            <div class="gallery-thumbnails">

            </div>
          
          </div>

          
          <!-- Informações do Produto -->
          <div class="product-info">
            <div class="breadcrumb">
              <a href="/products">Produtos</a> / <span id="breadcrumbCategory" class="skeleton">Categoria</span>
            </div>
            <h1 class="product-title skeleton" id="productTitle">
              Nome do Produto
            </h1>

            <div class="price-section">
              <div class="price skeleton" id="productPriceContainer">
                <span class="currency">R$</span>
                <span class="amount" id="productAmount">0,00</span>
              </div>
              <p class="price-note">Preço sujeito a alterações</p>
            </div>

            <!-- Especificações -->
            <div class="specifications">
              <h3>Especificações</h3>
              <div class="spec-item">
                <span class="spec-label">Categoria:</span>
                <span class="spec-value skeleton" id="specCategory">Carregando...</span>
              </div>
                <div class="spec-item" id="coresSpecItem" style="display: none;">
                  <span class="spec-label">Cores disponíveis:</span>
                  <span class="spec-value" id="specColors"></span>
                </div>

                <div class="spec-item" id="tamanhosSpecItem" style="display: none;">
                  <span class="spec-label">Tamanhos disponíveis:</span>
                  <span class="spec-value" id="specSizes"></span>
                </div>

          <div class="spec-item">
            <span class="spec-label">Estoque:</span>
            <span class="spec-value skeleton" id="specStock">0 unidades</span>
          </div>
            </div>

            <div class="selectors">
                <div class="variation-section" id="colorSelectorSection" style="display: none;">
                  <label>Cor:</label> 
                  <div class="pill-selector" id="colorPillSelector"></div>
                  <div id="colorError" class="validation-error" style="display:none">Selecione uma cor</div>
                  <input type="hidden" id="selectedColor" name="color">
                </div>

                <div class="variation-section" id="sizeSelectorSection" style="display: none;">
                  <label>Tamanho:</label> 
                  <div class="pill-selector" id="sizePillSelector"></div>
                  <div id="sizeError" class="validation-error" style="display:none">Selecione um tamanho</div>
                  <input type="hidden" id="selectedSize" name="size">
                </div>

                      <!-- Seletor de Quantidade -->
                      <div class="quantity-section">
                        <div class="quantity-control">
                          <button type="button" id="decreaseQtyBtn" class="qty-btn" disabled>-</button>
                          <input type="number" id="quantity" value="0" min="0" max="0" readonly>
                          <button type="button" id="increaseQtyBtn" class="qty-btn" disabled>+</button>
                        </div>
                      </div>
            </div>

            <!-- Botões de Ação -->
            <div class="action-buttons">
                <button class="btn-primary" id="addToCartButton" disabled>
                  <i class="material-icons">shopping_cart</i> Adicionar ao Carrinho
                </button>
                  <button class="btn-secondary btn-favorite" data-product-id="<%= product._id %>">
                    <i class="material-icons favorite-icon">favorite_border</i>
                    <span>Favoritar</span>
                  </button>
            </div>

            
            <!-- Garantia -->
            <div class="guarantee-section">
              <div class="guarantee-item">
                <i class="material-icons">local_shipping</i>
                <div>
                  <strong>Frete Grátis</strong>
                  <p>Em compras acima de R$ 100</p>
                </div>
              </div>
              <div class="guarantee-item">
                <i class="material-icons">shield_check</i>
                <div>
                  <strong>Garantia</strong>
                  <p>12 meses de cobertura</p>
                </div>
              </div>
              <div class="guarantee-item">
                <i class="material-icons">undo</i>
                <div>
                  <strong>Devolução</strong>
                  <p>30 dias para trocar</p>
                </div>
              </div>
            </div>
          </div>
        </div>

           <!-- 
            <div class="rating-section">
              <div class="stars">
                <% for(let i=0; i < 5; i++) { %>
                  <i class="material-icons">star</i>
                  <% } %>
              </div>
              <span class="rating-text">5.0 (45 avaliações)</span>
            </div>

     Seção de Descrição Expandida -->
        <div class="expanded-description">
          <h2>Sobre este Produto</h2>
          <p id="productDescription" class="skeleton">Carregando descrição detalhada do produto...</p>
          <p>Este produto foi cuidadosamente selecionado para atender aos mais altos padrões de qualidade e design.
            Perfeito para quem busca estilo e conforto em uma única peça.</p>
        </div>

        <div class="related-products">
          <h2>Você pode gostar também</h2>
          <p class="related-subtitle">Confira outros produtos da mesma categoria</p>
          <div class="related-grid">
            <div class="related-card">
              <img src="https://images.unsplash.com/photo-1460353581641-37baddab0fa2?auto=format&fit=crop&w=400&q=80"
                alt="Produto relacionado" loading="lazy">
              <h4>Produto Relacionado 1</h4>
              <p class="price">R$ 199.99</p>
            </div>
            <div class="related-card">
              <img src="https://images.unsplash.com/photo-1542291026-7eec264c27ff?auto=format&fit=crop&w=400&q=80"
                alt="Produto relacionado" loading="lazy">
              <h4>Produto Relacionado 2</h4>
              <p class="price">R$ 249.99</p>
            </div>
          </div>
        </div>
        <% } %>
</section>
<script>
  let productDataGlobal = null;
  let selectedVariation = null;

  async function getProductInfo() {
    const productId = '<%= product ? product._id : "" %>';
    const csrfToken = '<%= locals.csrfToken || "" %>';
    
    const elements = {
      title: document.getElementById('productTitle'),
      amount: document.getElementById('productAmount'),
      description: document.getElementById('productDescription')
    };

    if (!productId) return;

    try {
      const response = await fetch('/products/projectionByIds', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'x-csrf-token': csrfToken
        },
        body: JSON.stringify({ ids: [productId] })
      });
      const data = await response.json();
      const p = data[0];
      
      if (!p) return;
      productDataGlobal = p;

      // Cálculo inicial de estoque e preço (baseado na primeira variação)
      const variations = p.variacoes || [];
      const initialVar = variations[0] || {};
      const totalStock = variations.reduce((acc, v) => acc + (v.estoque || 0), 0);
      const initialPrice = initialVar.preco || 0;

      // Atualiza Imagem e Stock Badge
      const mainImg = document.getElementById('mainImage');
      const firstImage = initialVar.imagens?.[0] || 'placeholder-product.webp';
      mainImg.src = `/image/${firstImage}`;
      mainImg.alt = p.nome;
      mainImg.style.opacity = '1';
      mainImg.parentElement.classList.remove('skeleton');

      const stockBadge = document.getElementById('stockBadgeDisplay');
      stockBadge.textContent = totalStock > 0 ? 'Em estoque' : 'Indisponível';
      stockBadge.classList.remove('skeleton');

      // Thumbnails - Coleta todas as imagens de todas as variações
      const allImages = [...new Set(variations.flatMap(v => v.imagens || []))];
      const thumbContainer = document.querySelector('.gallery-thumbnails');
      thumbContainer.innerHTML = allImages.map((img, i) => `
        <div class="thumbnail ${i === 0 ? 'active' : ''}" onclick="updateGallery('/image/${img}', this)">
          <img src="/image/${img}" alt="Miniatura ${i}" loading="lazy">
        </div>
      `).join('');

      // Informações Textuais
      elements.title.textContent = p.nome;
      elements.title.classList.remove('skeleton');
      
      document.getElementById('breadcrumbCategory').textContent = p.categoria || 'Geral';
      document.getElementById('breadcrumbCategory').classList.remove('skeleton');
      
      document.getElementById('specCategory').textContent = p.categoria || 'Geral';
      document.getElementById('specCategory').classList.remove('skeleton');

      document.getElementById('productAmount').textContent = initialPrice.toLocaleString('pt-BR', { minimumFractionDigits: 2 });
      document.getElementById('productPriceContainer').classList.remove('skeleton');

      document.getElementById('specStock').textContent = `${totalStock} unidades`;
      document.getElementById('specStock').classList.remove('skeleton');

      elements.description.textContent = p.descricao || 'Sem descrição disponível.';
      elements.description.classList.remove('skeleton');

      // Configura Seletores de Variação
      renderVariationSelectors(variations);

      // Habilita botão se houver estoque
      if (totalStock > 0) {
        document.getElementById('addToCartButton').disabled = false;
      }
    
    } catch (error) {
      console.error("Erro ao buscar informações do produto:", error);
    }
  }

  function renderVariationSelectors(variations) {
    const colors = [...new Set(variations.flatMap(v => v.cores || []))];
    const sizes = [...new Set(variations.flatMap(v => v.tamanhos || []))];

    if (colors.length > 0) {
      const colorSection = document.getElementById('colorSelectorSection');
      const colorContainer = document.getElementById('colorPillSelector');
      colorSection.style.display = 'block';
      colorContainer.innerHTML = colors.map(c => `
        <div class="pill-option" onclick="selectAttribute('color', '${c}', this)">${c}</div>
      `).join('');
      
      // Atualiza spec
      document.getElementById('coresSpecItem').style.display = 'block';
      document.getElementById('specColors').textContent = colors.join(', ');
    }

    if (sizes.length > 0) {
      const sizeSection = document.getElementById('sizeSelectorSection');
      const sizeContainer = document.getElementById('sizePillSelector');
      sizeSection.style.display = 'block';
      sizeContainer.innerHTML = sizes.map(s => `
        <div class="pill-option" onclick="selectAttribute('size', '${s}', this)">${s}</div>
      `).join('');

      // Atualiza spec
      document.getElementById('tamanhosSpecItem').style.display = 'block';
      document.getElementById('specSizes').textContent = sizes.join(', ');
    }
  }

  function selectAttribute(type, value, el) {
    // Toggle UI
    el.parentElement.querySelectorAll('.pill-option').forEach(p => p.classList.remove('selected'));
    el.classList.add('selected');
    
    const color = type === 'color' ? value : document.querySelector('#colorPillSelector .selected')?.textContent;
    const size = type === 'size' ? value : document.querySelector('#sizePillSelector .selected')?.textContent;

    // Tenta encontrar a variação exata
    const match = productDataGlobal.variacoes.find(v => 
      (!color || v.cores.includes(color)) && 
      (!size || v.tamanhos.includes(size))
    );

    if (match) {
      document.getElementById('productAmount').textContent = match.preco.toLocaleString('pt-BR', { minimumFractionDigits: 2 });
      document.getElementById('specStock').textContent = `${match.estoque} unidades`;
      if (match.imagens?.[0]) {
        updateGallery(`/image/${match.imagens[0]}`);
      }
    }
  }

  function updateGallery(src, thumbEl = null) {
    const mainImg = document.getElementById('mainImage');
    mainImg.style.opacity = '0';
    setTimeout(() => {
      mainImg.src = src;
      mainImg.style.opacity = '1';
    }, 200);

    if (thumbEl) {
      document.querySelectorAll('.thumbnail').forEach(t => t.classList.remove('active'));
      thumbEl.classList.add('active');
    }
  }

  function changeMainImage(element) {
    const mainImg = document.getElementById('mainImage');
    mainImg.src = element.src;
    document.querySelectorAll('.thumbnail').forEach(t => t.classList.remove('active'));
    element.classList.add('active');
  }

  function exibirEspecificacao(itemId, valueId, lista) {
    if (lista && lista.length > 0) {
      document.getElementById(itemId).style.display = 'block';
      document.getElementById(valueId).textContent = lista.join(', ');
    }
  }

  getProductInfo();
</script>

<script src="/js/favorited.js"></script>