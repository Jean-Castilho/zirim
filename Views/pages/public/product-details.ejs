<link rel="stylesheet" href="/css/pages/product-details.css">

<section class="product-details-page">
        <div class="product-details-container">
          <!-- Galeria de Imagens -->
          <div class="product-gallery">
            
            <div class="main-image-container skeleton"> 
              <img id="mainImage" 
                   src="/img/placeholder-product.webp"
                   alt="Carregando..."
                   class="main-image" style="opacity: 0; transition: opacity 0.5s ease;">
              <span class="stock-badge skeleton" id="stockBadgeDisplay">Carregando</span>
            </div>

            <div class="gallery-thumbnails">

            </div>
          
          </div>

          
          <!-- Informações do Produto -->
          <div class="product-info">
            <div class="breadcrumb">
              <a href="/products">Produtos</a> / <span id="breadcrumbCategory" class="skeleton">Categoria</span>
            </div>
            <h1 class="product-title skeleton" id="productTitle">
              Nome do Produto
            </h1>

            <div class="price-section">
              <div class="price skeleton" id="productPriceContainer">
                <span class="currency"></span>
                <span class="amount" id="productAmount"></span>
              </div>
              <p class="price-note">Preço sujeito a alterações</p>
            </div>

            <!-- Especificações -->
            <div class="specifications">
              <h3>Especificações</h3>
              <div class="spec-item">
                <span class="spec-label">Categoria:</span>
                <span class="spec-value skeleton" id="specCategory">Carregando...</span>
              </div>

          <div class="spec-item">
            <span class="spec-label">Estoque:</span>
            <span class="spec-value skeleton" id="specStock">0 unidades</span>
          </div>
            </div>

            <div class="selectors">
                <div class="variation-section" id="colorSelectorSection" style="display: none;">
                  <label>Cor:</label> 
                  <div class="pill-selector" id="colorPillSelector"></div>
                  <div id="colorError" class="validation-error" style="display:none">Selecione uma cor</div>
                  <input type="hidden" id="selectedColor" name="color">
                </div>

                <div class="variation-section" id="sizeSelectorSection" style="display: none;">
                  <label>Tamanho:</label> 
                  <div class="pill-selector" id="sizePillSelector"></div>
                  <div id="sizeError" class="validation-error" style="display:none">Selecione um tamanho</div>
                  <input type="hidden" id="selectedSize" name="size">
                </div>
              
                      <!-- Seletor de Quantidade -->
                      <div class="quantity-section">
                        <div class="quantity-control">
                          <button type="button" id="decreaseQtyBtn" class="qty-btn" disabled>-</button>
                          <input type="number" id="quantity" value="0" min="0" max="0" readonly>
                          <button type="button" id="increaseQtyBtn" class="qty-btn" disabled>+</button>
                        </div>
                      </div>
            </div>

            <!-- Botões de Ação -->
            <div class="action-buttons">
                <button class="btn-primary" id="addToCartButton" disabled>
                  <i class="material-icons">shopping_cart</i> Adicionar ao Carrinho
                </button>
                  <button class="btn-secondary btn-favorite" data-product-id="<%= product._id %>">
                    <i class="material-icons favorite-icon">favorite_border</i>
                    <span>Favoritar</span>
                  </button>
            </div>

            
            <!-- Garantia -->
            <div class="guarantee-section">
              <div class="guarantee-item">
                <i class="material-icons">local_shipping</i>
                <div>
                  <strong>Frete Grátis</strong>
                  <p>Em compras acima de R$ 100</p>
                </div>
              </div>
              <div class="guarantee-item">
                <i class="material-icons">shield_check</i>
                <div>
                  <strong>Garantia</strong>
                  <p>12 meses de cobertura</p>
                </div>
              </div>
              <div class="guarantee-item">
                <i class="material-icons">undo</i>
                <div>
                  <strong>Devolução</strong>
                  <p>30 dias para trocar</p>
                </div>
              </div>
            </div>
          </div>
        </div>

           <!-- 
            <div class="rating-section">
              <div class="stars">
                <% for(let i=0; i < 5; i++) { %>
                  <i class="material-icons">star</i>
                  <% } %>
              </div>
              <span class="rating-text">5.0 (45 avaliações)</span>
            </div>

     Seção de Descrição Expandida -->
        <div class="expanded-description">
          <h2>Sobre este Produto</h2>
          <p id="productDescription" class="skeleton">Carregando descrição detalhada do produto...</p>
          <p>Este produto foi cuidadosamente selecionado para atender aos mais altos padrões de qualidade e design.
            Perfeito para quem busca estilo e conforto em uma única peça.</p>
        </div>

        <div class="related-products">
          <h2>Você pode gostar também</h2>
          <div class="related-grid">
            <div class="related-card">
              <img src="https://images.unsplash.com/photo-1460353581641-37baddab0fa2?auto=format&fit=crop&w=400&q=80"
                alt="Produto relacionado" loading="lazy">
              <h4>Produto Relacionado 1</h4>
              <p class="price">R$ 199.99</p>
            </div>
            <div class="related-card">
              <img src="https://images.unsplash.com/photo-1542291026-7eec264c27ff?auto=format&fit=crop&w=400&q=80"
                alt="Produto relacionado" loading="lazy">
              <h4>Produto Relacionado 2</h4>
              <p class="price">R$ 249.99</p>
            </div>
          </div>
        </div>
</section>
<script>
  let productDataGlobal = null;
  let selectedVariation = null;

  // Controles de Quantidade
  const qtyInput = document.getElementById('quantity');
  const decreaseBtn = document.getElementById('decreaseQtyBtn');
  const increaseBtn = document.getElementById('increaseQtyBtn');
  const addToCartBtn = document.getElementById('addToCartButton');

  function updateQuantity(val) {
    let current = parseInt(qtyInput.value) || 0;
    const max = parseInt(qtyInput.max) || 0;
    
    if (val > 0 && current < max) current++;
    if (val < 0 && current > 1) current--;
    
    qtyInput.value = current;
    decreaseBtn.disabled = current <= 1;
    increaseBtn.disabled = current >= max;
  }

  decreaseBtn.addEventListener('click', () => updateQuantity(-1));
  increaseBtn.addEventListener('click', () => updateQuantity(1));

  function resetQuantity(maxStock) {
    qtyInput.value = maxStock > 0 ? 1 : 0;
    qtyInput.max = maxStock;
    updateQuantity(0);
  }

  async function getProductInfo() {
    const productId = '<%= product._id %>';
    const csrfToken = '<%= locals.csrfToken || "" %>';
    
    const elements = {
      title: document.getElementById('productTitle'),
      amount: document.getElementById('productAmount'),
      description: document.getElementById('productDescription')
    };

    if (!productId) return;

    try {
      const response = await fetch('/products/projectionByIds', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json'
        },
        body: JSON.stringify({ ids: [productId] })
      });
      const data = await response.json();

      console.log(data);

      const p = data[0];
      
      if (!p) return;
      productDataGlobal = p;

      // Cálculo inicial de estoque e preço (baseado na primeira variação)
      const variations = p.variacoes || [];
      const initialVar = variations[0] || {};
      const totalStock = variations.reduce((acc, v) => acc + (v.estoque || 0), 0);
      const initialPrice = initialVar.preco || 0;

      // Atualiza Imagem e Stock Badge
      const mainImg = document.getElementById('mainImage');
      const firstImage = initialVar.imagens?.[0] || 'placeholder-product.webp';
      mainImg.src = `/image/${firstImage}`;
      mainImg.alt = p.nome;
      mainImg.style.opacity = '1';
      mainImg.parentElement.classList.remove('skeleton');

      const stockBadge = document.getElementById('stockBadgeDisplay');
      stockBadge.textContent = totalStock > 0 ? 'Em estoque' : 'Indisponível';
      stockBadge.classList.remove('skeleton');

      // Thumbnails - Coleta todas as imagens de todas as variações
      const allImages = [...new Set(variations.flatMap(v => v.imagens || []))];
      const thumbContainer = document.querySelector('.gallery-thumbnails');
      thumbContainer.innerHTML = allImages.map((img, i) => `
        <div class="thumbnail ${i === 0 ? 'active' : ''}" onclick="updateGallery('/image/${img}', this)">
          <img src="/image/${img}" alt="Miniatura ${i}" loading="lazy">
        </div>
      `).join('');

      // Informações Textuais
      elements.title.textContent = p.nome;
      elements.title.classList.remove('skeleton');
      
      document.getElementById('breadcrumbCategory').textContent = p.categoria || 'Geral';
      document.getElementById('breadcrumbCategory').classList.remove('skeleton');
      
      document.getElementById('specCategory').textContent = p.categoria || 'Geral';
      document.getElementById('specCategory').classList.remove('skeleton');

      document.getElementById('productAmount').textContent = initialPrice.toLocaleString('pt-BR', { minimumFractionDigits: 2 });
      document.getElementById('productPriceContainer').classList.remove('skeleton');

      document.getElementById('specStock').textContent = `${totalStock} unidades`;
      document.getElementById('specStock').classList.remove('skeleton');

      elements.description.textContent = p.descricao || 'Sem descrição disponível.';
      elements.description.classList.remove('skeleton');

      // Configura Seletores de Variação
      renderVariationSelectors(variations);

      // Habilita o botão se houver estoque disponível em qualquer variação.
      // A validação de seleção específica agora ocorre no clique do botão.
      addToCartBtn.disabled = totalStock <= 0;
    
    } catch (error) {
      console.error("Erro ao buscar informações do produto:", error);
    }
  }

  function renderVariationSelectors(variations) {
    const colors = [...new Set(variations.flatMap(v => v.cores || []))];
    const sizes = [...new Set(variations.flatMap(v => v.tamanhos || []))];

    if (colors.length > 0) {
      const colorSection = document.getElementById('colorSelectorSection');
      const colorContainer = document.getElementById('colorPillSelector');
      colorSection.style.display = 'block';
      colorContainer.innerHTML = colors.map(c => `
        <div class="pill-option" onclick="selectAttribute('color', '${c}', this)">${c}</div>
      `).join('');
    }

    if (sizes.length > 0) {
      const sizeSection = document.getElementById('sizeSelectorSection');
      const sizeContainer = document.getElementById('sizePillSelector');
      sizeSection.style.display = 'block';
      sizeContainer.innerHTML = sizes.map(s => `
        <div class="pill-option" onclick="selectAttribute('size', '${s}', this)">${s}</div>
      `).join('');
    }
  }

  function selectAttribute(type, value, el) {
    if (el) {
      const isAlreadySelected = el.classList.contains('selected');

      if (isAlreadySelected) {
        // Deseleciona se clicar no item já ativo (Liberdade de navegação)
        el.classList.remove('selected');
      } else {
        // Se clicar em algo bloqueado visualmente, resetamos o seletor oposto para destravar a navegação
        if (el.classList.contains('disabled')) {
          const otherSelector = type === 'color' ? '#sizePillSelector' : '#colorPillSelector';
          document.querySelectorAll(`${otherSelector} .pill-option`).forEach(p => p.classList.remove('selected'));
        }
        
        // Define a nova seleção no grupo
        el.parentElement.querySelectorAll('.pill-option').forEach(p => p.classList.remove('selected'));
        el.classList.add('selected');
      }
    }

    // Captura os valores selecionados após a atualização das classes
    const color = document.querySelector('#colorPillSelector .selected')?.textContent?.trim();
    const size = document.querySelector('#sizePillSelector .selected')?.textContent?.trim();

    // Atualiza a disponibilidade visual dos outros atributos
    updatePillAvailability(color, size);

    // Encontra as variações que batem com a seleção (suporta strings com espaços do DB)
    const matches = productDataGlobal.variacoes.filter(v => 
      (!color || v.cores.map(c => c.trim()).includes(color)) && 
      (!size || v.tamanhos.map(s => String(s).trim()).includes(size))
    );

    // Calcula o estoque total da seleção atual (soma se parcial, valor único se completo)
    const currentStock = matches.reduce((acc, v) => acc + (v.estoque || 0), 0);
    document.getElementById('specStock').textContent = `${currentStock} unidades`;

    const isColorRequired = document.getElementById('colorSelectorSection').style.display !== 'none';
    const isSizeRequired = document.getElementById('sizeSelectorSection').style.display !== 'none';
    
    // Verifica se todos os atributos visíveis foram selecionados
    const selectionComplete = (!isColorRequired || !!color) && (!isSizeRequired || !!size);
    const colorError = document.getElementById('colorError');
    const sizeError = document.getElementById('sizeError');
    const colorContainer = document.getElementById('colorPillSelector');
    const sizeContainer = document.getElementById('sizePillSelector');

    // Limpa estados de erro visual ao selecionar um atributo
    if (color) { 
      colorError.classList.remove('active'); 
      colorContainer.classList.remove('error-ring'); 
    }
    if (size) { 
      sizeError.classList.remove('active'); 
      sizeContainer.classList.remove('error-ring'); 
    }

    if (selectionComplete && matches.length > 0) {
      const match = matches[0]; // Na seleção completa, o primeiro match é a variação única
      selectedVariation = match;
      document.getElementById('productAmount').textContent = match.preco.toLocaleString('pt-BR', { minimumFractionDigits: 2 });
      
      resetQuantity(match.estoque);
      
      if (match.imagens?.[0]) updateGallery(`/image/${match.imagens[0]}`);
      addToCartBtn.disabled = match.estoque <= 0;
    } else {
      selectedVariation = null;
      resetQuantity(currentStock);

      // Retorna ao preço inicial quando a seleção está incompleta ou vazia
      if (productDataGlobal && productDataGlobal.variacoes?.[0]) {
        document.getElementById('productAmount').textContent = productDataGlobal.variacoes[0].preco.toLocaleString('pt-BR', { minimumFractionDigits: 2 });
      }
    }
  }

  function updatePillAvailability(selectedColor, selectedSize) {
    if (!productDataGlobal || !productDataGlobal.variacoes) return;

    // Se uma cor foi selecionada, desabilita tamanhos sem estoque para essa cor
    if (document.getElementById('sizeSelectorSection').style.display !== 'none') {
      const sizePills = document.querySelectorAll('#sizePillSelector .pill-option');
      sizePills.forEach(pill => {
        const sizeVal = pill.textContent.trim();
        const hasStock = productDataGlobal.variacoes.some(v => 
          (!selectedColor || v.cores.map(c => c.trim()).includes(selectedColor)) && 
          v.tamanhos.includes(sizeVal) && 
          v.estoque > 0
        );
        pill.classList.toggle('disabled', !hasStock);
      });
    }

    // Se um tamanho foi selecionado, desabilita cores sem estoque para esse tamanho
    if (document.getElementById('colorSelectorSection').style.display !== 'none') {
      const colorPills = document.querySelectorAll('#colorPillSelector .pill-option');
      colorPills.forEach(pill => {
        const colorVal = pill.textContent.trim();
        const hasStock = productDataGlobal.variacoes.some(v => 
          v.cores.map(c => c.trim()).includes(colorVal) && 
          (!selectedSize || v.tamanhos.includes(selectedSize)) && 
          v.estoque > 0
        );
        pill.classList.toggle('disabled', !hasStock);
      });
    }
  }

  function updateGallery(src, thumbEl = null) {
    const mainImg = document.getElementById('mainImage');
    mainImg.style.opacity = '0';
    setTimeout(() => {
      mainImg.src = src;
      mainImg.style.opacity = '1';
    }, 200);

    if (thumbEl) {
      document.querySelectorAll('.thumbnail').forEach(t => t.classList.remove('active'));
      thumbEl.classList.add('active');
    }
  }

  function changeMainImage(element) {
    const mainImg = document.getElementById('mainImage');
    mainImg.src = element.src;
    document.querySelectorAll('.thumbnail').forEach(t => t.classList.remove('active'));
    element.classList.add('active');
  }

  function exibirEspecificacao(itemId, valueId, lista) {
    if (lista && lista.length > 0) {
      document.getElementById(itemId).style.display = 'block';
      document.getElementById(valueId).textContent = lista.join(', ');
    }
  }

  addToCartBtn.addEventListener('click', () => {
    const isColorRequired = document.getElementById('colorSelectorSection').style.display !== 'none';
    const isSizeRequired = document.getElementById('sizeSelectorSection').style.display !== 'none';
    const colorSelected = document.querySelector('#colorPillSelector .selected');
    const sizeSelected = document.querySelector('#sizePillSelector .selected');

    let hasError = false;

    if (isColorRequired && !colorSelected) {
      document.getElementById('colorError').classList.add('active');
      document.getElementById('colorPillSelector').classList.add('error-ring');
      hasError = true;
    }

    if (isSizeRequired && !sizeSelected) {
      document.getElementById('sizeError').classList.add('active');
      document.getElementById('sizePillSelector').classList.add('error-ring');
      hasError = true;
    }

    if (hasError) {
      if (typeof showNotification === 'function') {
        showNotification('Selecione as opções desejadas antes de prosseguir.', 'error');
      }
      return;
    }

    if (!selectedVariation) return;

    const cartItem = {
      productId: productDataGlobal._id,
      variationId: selectedVariation._id || `${productDataGlobal._id}-${selectedVariation.cores[0]}-${selectedVariation.tamanhos[0]}`,
      cor: document.querySelector('#colorPillSelector .selected')?.textContent,
      tamanho: document.querySelector('#sizePillSelector .selected')?.textContent,
      nome: productDataGlobal.nome,
      preco: selectedVariation.preco,
      quantidade: parseInt(qtyInput.value),
      imagem: selectedVariation.imagens?.[0] ? `/image/${selectedVariation.imagens[0]}` : '/img/placeholder-product.webp',
      estoqueMax: selectedVariation.estoque
    };

    saveToCart(cartItem);
  });

  function saveToCart(item) {
    let cart = JSON.parse(localStorage.getItem('cart') || '[]');
    
    const existingIndex = cart.findIndex(i => i.variationId === item.variationId);
    

    if (existingIndex > -1) {
      const newQty = cart[existingIndex].quantidade + item.quantidade;
      cart[existingIndex].quantidade = Math.min(newQty, item.estoqueMax);
    } else {
      cart.push(item);
    }

    localStorage.setItem('cart', JSON.stringify(cart));
    showNotification(`adicionado ao carrinho!`, 'success');
  }

  /**
   * Função adicional para resetar completamente a navegação de variações.
   * Pode ser vinculada a um botão de "Limpar escolhas".
   */
  function clearAllVariationSelections() {
    document.querySelectorAll('.pill-option').forEach(p => p.classList.remove('selected'));
    // Dispara a lógica de atualização passando null para os parâmetros
    selectAttribute(null, null, null);
  }

  getProductInfo();
</script>

<script src="/js/favorited.js"></script>