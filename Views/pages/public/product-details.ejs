<link rel="stylesheet" href="/css/pages/product-details.css">

<style>
  .pill-option.selected {
    border-radius: 5px; 
    border-color: #0056b3;
    background-color: #dce9f9;
    color: #0056b3;
    font-weight: 600;
    box-shadow: 0 0 0 2px rgba(0, 86, 179, 0.2);
  }

  .pill-option-color.selected .color-swatch {
    outline: 2px solid #0056b3;
    outline-offset: 2px;
  }

  .main-image {
    transition: opacity 0.3s ease, transform 0.4s ease;
  }

  .thumbnail.active {
    border: 2px solid #0056b3;
    opacity: 1;
    transform: scale(1.05);
  }

  .qty-btn:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  #addToCartButton:not(:disabled):active {
    transform: scale(0.98);
  }
</style>

<section class="product-details-page">
  <% 
    const productName = product?.nome; 
    const productCategory = product?.categoria; 
    const productDescription = product?.descricao || 'Sem descrição disponível.';
    
    const allVariations = product?.variacoes || [];
    const initialVariation = allVariations.find(v => v.ativo && v.estoque > 0) || null;

    const initialPrice = initialVariation?.preco ?? product?.preco ?? 0;
    const initialEstoque = initialVariation?.estoque ?? 0;
    
    const initialImages = initialVariation?.imagens?.length > 0 
      ? initialVariation.imagens 
      : product?.imagens || [];

    const galleryImages = initialImages.map(img => `/image/${img}`).slice(0, 5);

    const inStockActiveVariations = allVariations.filter(v => v.ativo && v.estoque > 0);
    const productCores = [
      ...new Set(inStockActiveVariations.flatMap(v => v.cores || []))
    ].filter(Boolean);

    const productTamanhos = [
      ...new Set(inStockActiveVariations.flatMap(v => v.tamanhos || []))
    ].filter(Boolean);

  %>

    <% if (!product) { %>
      <div class="product-not-found">
        <h2>Produto não encontrado</h2>
        <p>Verifique se o link está correto ou tente novamente mais tarde.</p>
        <a href="/products" class="btn-back-products">Voltar para produtos</a>
      </div>
      <% } else { %>
        <div class="product-details-container">
          <!-- Galeria de Imagens -->
          <div class="product-gallery">
            
            <div class="main-image-container"> 
              <img id="mainImage" src="<%= galleryImages[0] || '/path/to/default/image.webp' %>" alt="<%= productName %>" class="main-image">
              <span class="stock-badge" id="stockBadgeDisplay">
                <% if (initialEstoque > 0) { %>
                  Em Estoque
                <% } else { %>
                  Indisponível
                <% } %>
              </span>
            </div>

            <div class="gallery-thumbnails">
              <% galleryImages.forEach((img, idx) => { %>
                <img src="<%= img %>" alt="<%= productName %> view <%= idx + 1 %>"
                  class="thumbnail <%= idx === 0 ? 'active' : '' %>" data-img-src="<%= img %>">
                <% }) %>
            </div>
          
          </div>

          
          <!-- Informações do Produto -->
          <div class="product-info">
            <div class="breadcrumb">
              <a href="/products">Produtos</a> / <span>
                <%= productCategory %>
              </span>
            </div>
            <h1 class="product-title">
              <%= productName %>
            </h1>

            <div class="price-section">
              <div class="price">
                <span class="currency">R$</span>
                <span class="amount" id="productPriceDisplay">
                  <%= initialPrice.toFixed(2) %>
                </span>
              </div>
              <p class="price-note">Preço sujeito a alterações</p>
            </div>

            <!-- Especificações -->
            <div class="specifications">
              <h3>Especificações</h3>
              <div class="spec-item">
                <span class="spec-label">Categoria:</span>
                <span class="spec-value">
                  <%= productCategory %>
                </span>
              </div>
              <% if (productCores.length > 0) { %>
                <div class="spec-item">
                  <span class="spec-label">Cores disponíveis:</span>
                  <span class="spec-value" id="productCoresDisplay">
                    <%= productCores.join(', ') %></span>
          </div>
          <% } %>
          <% if (productTamanhos.length > 0) { %>
          <div class="spec-item">
            <span class="spec-label">Tamanhos disponíveis:</span>
            <span class="spec-value" id="productTamanhosDisplay"><%= productTamanhos.join(' , ') %></span>
          </div>
          <% } %>
          <div class="spec-item">
            <span class="spec-label">Estoque:</span>
            <span class="spec-value" id="productEstoqueDisplay"><%= initialEstoque > 0 ? initialEstoque + ' unidades' : 'Indisponível' %>
            </span>
                </div>
            </div>

            <div class="selectors">
              <% if (productCores.length > 0) { %>
                <div class="variation-section">
                  <label>Cor:</label> 
                  <div class="pill-selector" id="colorPillSelector">
                    <% productCores.forEach((cor)=> { %>
                      <div class="pill-option pill-option-color" data-value="<%= cor %>">
                        <span class="color-swatch"></span>
                          </div> 
                      <% }) %>
                  </div>
                  <input type="hidden" id="selectedColor" name="color">
                </div>
                <% } %>


                  <% if (productTamanhos.length > 0) { %>
                    <div class="variation-section">
                      <label>Tamanho:</label> 
                      <div class="pill-selector" id="sizePillSelector">
                        <% productTamanhos.forEach((tamanho)=> { %>
                          <div class="pill-option" data-value="<%= tamanho %>">
                            <%= tamanho %>
                          </div>
                          <% }) %>
                      </div>
                      <input type="hidden" id="selectedSize" name="size">
                    </div>
                    <% } %>

                      <!-- Seletor de Quantidade -->
                      <div class="quantity-section">
                        <div class="quantity-control">
                          <button type="button" id="decreaseQtyBtn" class="qty-btn" <%= initialEstoque <= 0 ? 'disabled' : '' %>>-</button>
                          <input type="number" id="quantity" value="<%= initialEstoque > 0 ? 1 : 0 %>" min="<%= initialEstoque > 0 ? 1 : 0 %>" max="<%= initialEstoque %>" readonly>
                          <button type="button" id="increaseQtyBtn" class="qty-btn" <%= initialEstoque <= 0 ? 'disabled' : '' %>>+</button>
                        </div>
                      </div>
            </div>

            <!-- Botões de Ação -->
            <div class="action-buttons">
              <% if (allVariations.length > 0) { %>
                <button class="btn-primary" id="addToCartButton" disabled>
                  <i class="material-icons">shopping_cart</i>
                  Selecione as opções
                </button>
                <% } else { %>
                  <button class="btn-primary" id="addToCartButton" <%= initialEstoque > 0 ? '' : 'disabled' %>>
                    <i class="material-icons">shopping_cart</i> <%= initialEstoque > 0 ? 'Adicionar ao Carrinho' : 'Produto Indisponível' %>
                  </button>
                  <% } %>
                  <button class="btn-secondary btn-favorite" data-product-id="<%= product._id %>">
                    <i class="material-icons favorite-icon">favorite_border</i>
                    <span>Favoritar</span>
                  </button>
            </div>

            
            <!-- Garantia -->
            <div class="guarantee-section">
              <div class="guarantee-item">
                <i class="material-icons">local_shipping</i>
                <div>
                  <strong>Frete Grátis</strong>
                  <p>Em compras acima de R$ 100</p>
                </div>
              </div>
              <div class="guarantee-item">
                <i class="material-icons">shield_check</i>
                <div>
                  <strong>Garantia</strong>
                  <p>12 meses de cobertura</p>
                </div>
              </div>
              <div class="guarantee-item">
                <i class="material-icons">undo</i>
                <div>
                  <strong>Devolução</strong>
                  <p>30 dias para trocar</p>
                </div>
              </div>
            </div>
          </div>
        </div>

           <!-- 
            <div class="rating-section">
              <div class="stars">
                <% for(let i=0; i < 5; i++) { %>
                  <i class="material-icons">star</i>
                  <% } %>
              </div>
              <span class="rating-text">5.0 (45 avaliações)</span>
            </div>

     Seção de Descrição Expandida -->
        <div class="expanded-description">
          <h2>Sobre este Produto</h2>
          <p>
            <%= productDescription %>
          </p>
          <p>Este produto foi cuidadosamente selecionado para atender aos mais altos padrões de qualidade e design.
            Perfeito para quem busca estilo e conforto em uma única peça.</p>
        </div>

        <div class="related-products">
          <h2>Você pode gostar também</h2>
          <p class="related-subtitle">Confira outros produtos da mesma categoria</p>
          <div class="related-grid">
            <div class="related-card">
              <img src="https://images.unsplash.com/photo-1460353581641-37baddab0fa2?auto=format&fit=crop&w=400&q=80"
                alt="Produto relacionado">
              <h4>Produto Relacionado 1</h4>
              <p class="price">R$ 199.99</p>
            </div>
            <div class="related-card">
              <img src="https://images.unsplash.com/photo-1542291026-7eec264c27ff?auto=format&fit=crop&w=400&q=80"
                alt="Produto relacionado">
              <h4>Produto Relacionado 2</h4>
              <p class="price">R$ 249.99</p>
            </div>
          </div>
        </div>
        <% } %>
</section>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const App = {
      state: {
        product: JSON.parse('<%- JSON.stringify(product) %>'),
        selectedColor: null,
        selectedSize: null,
      },

      elements: {
        mainImage: document.getElementById('mainImage'),
        galleryThumbnails: document.querySelector('.gallery-thumbnails'),
        priceDisplay: document.getElementById('productPriceDisplay'),
        stockDisplay: document.getElementById('productEstoqueDisplay'),
        stockBadge: document.getElementById('stockBadgeDisplay'),
        colorSelector: document.getElementById('colorPillSelector'),
        sizeSelector: document.getElementById('sizePillSelector'),
        colorInput: document.getElementById('selectedColor'),
        sizeInput: document.getElementById('selectedSize'),
        quantityInput: document.getElementById('quantity'),
        decreaseQtyBtn: document.getElementById('decreaseQtyBtn'),
        increaseQtyBtn: document.getElementById('increaseQtyBtn'),
        addToCartBtn: document.getElementById('addToCartButton'),
      },

      init() {
        if (!this.state.product) return;
        this.applyColorSwatches();
        this.bindEvents();
        this.updatePillStates();
      },

      bindEvents() {
        this.elements.decreaseQtyBtn?.addEventListener('click', () => this.handleQuantityChange(-1));
        this.elements.increaseQtyBtn?.addEventListener('click', () => this.handleQuantityChange(1));
        this.elements.colorSelector?.addEventListener('click', (e) => this.handlePillClick(e, 'color'));
        this.elements.sizeSelector?.addEventListener('click', (e) => this.handlePillClick(e, 'size'));
        this.elements.addToCartBtn?.addEventListener('click', () => this.handleAddToCart());
        this.elements.galleryThumbnails?.addEventListener('click', (e) => this.handleThumbnailClick(e));
      },

      handleQuantityChange(change) {
        const current = parseInt(this.elements.quantityInput.value, 10);
        const max = parseInt(this.elements.quantityInput.max, 10);
        let newValue = current + change;
        if (newValue < 1) newValue = 1;
        if (newValue > max) newValue = max;
        this.elements.quantityInput.value = newValue;
      },

      handlePillClick(event, type) {
        const clickedPill = event.target.closest('.pill-option');
        if (!clickedPill || clickedPill.classList.contains('disabled')) return;

        const value = clickedPill.dataset.value;
        const isCurrentlySelected = clickedPill.classList.contains('selected');
        const hiddenInput = type === 'color' ? this.elements.colorInput : this.elements.sizeInput;

        if (isCurrentlySelected) {
          if (type === 'color') this.state.selectedColor = null;
          if (type === 'size') this.state.selectedSize = null;
          hiddenInput.value = '';
          clickedPill.classList.remove('selected');
        } else {
          if (type === 'color') this.state.selectedColor = value;
          if (type === 'size') this.state.selectedSize = value;
          hiddenInput.value = value;
          Array.from(clickedPill.parentElement.children).forEach(p => p.classList.remove('selected'));
          clickedPill.classList.add('selected');
        }

        this.updatePillStates();
        this.updateProductDisplay();
      },

      handleThumbnailClick(event) {
        const thumbnail = event.target.closest('.thumbnail');
        if (!thumbnail) return;
        
        // Transition effect
        this.elements.mainImage.style.opacity = '0.5';
        setTimeout(() => {
          this.elements.mainImage.src = thumbnail.dataset.imgSrc;
          this.elements.mainImage.style.opacity = '1';
        }, 100);

        Array.from(this.elements.galleryThumbnails.children).forEach(thumb => thumb.classList.remove('active'));
        thumbnail.classList.add('active');
      },

      getVariationDetails() {
        const variations = this.state.product.variacoes || [];
        const { selectedColor, selectedSize } = this.state;

        if (variations.length === 0) {
          const stock = Number(this.state.product.estoque || 0);
          return {
            stock,
            price: Number(this.state.product.preco || 0),
            images: (this.state.product.imagens || []).map(img => `/image/${img}`),
            active: stock > 0,
            variation: null,
          };
        }

        let matchedVariation = null;

        if (selectedColor && selectedSize) {
          matchedVariation = variations.find(v =>
            v.ativo &&
            v.cores?.includes(selectedColor) &&
            v.tamanhos?.includes(selectedSize)
          );
        } else if (selectedColor) {
          matchedVariation = variations.find(v =>
            v.ativo &&
            v.cores?.includes(selectedColor)
          );
        } else if (selectedSize) {
          matchedVariation = variations.find(v =>
            v.ativo &&
            v.tamanhos?.includes(selectedSize)
          );
        }

        const productImages = (this.state.product.imagens || []).map(img => `/image/${img}`);
        
        if (!matchedVariation) {
            // Se não houver match completo, tenta encontrar o mais próximo ou mantém o inicial
            matchedVariation = variations.find(v => v.ativo && v.estoque > 0) || variations.find(v => v.ativo) || variations[0];
        }

        const images = matchedVariation?.imagens?.length > 0
          ? matchedVariation.imagens.map(img => `/image/${img}`)
          : productImages;

        return {
          stock: Number(matchedVariation?.estoque ?? this.state.product.estoque ?? 0),
          price: Number(matchedVariation?.preco ?? this.state.product.preco ?? 0),
          images,
          active: matchedVariation?.ativo ?? (this.state.product.estoque || 0) > 0,
          variation: matchedVariation || null,
        };
      },

      updateProductDisplay() {
        const details = this.getVariationDetails();
        const stock = Number(details.stock || 0);

        this.elements.priceDisplay.textContent = Number(details.price || 0).toFixed(2);
        this.elements.stockDisplay.textContent = stock > 0 ? `${stock} unidades` : 'Indisponível';
        this.elements.quantityInput.max = stock;
        
        if (stock <= 0) {
            this.elements.quantityInput.value = 0;
            this.elements.quantityInput.min = 0;
            this.elements.decreaseQtyBtn.disabled = true;
            this.elements.increaseQtyBtn.disabled = true;
        } else {
            if (parseInt(this.elements.quantityInput.value, 10) === 0) this.elements.quantityInput.value = 1;
            this.elements.quantityInput.min = 1;
            this.elements.decreaseQtyBtn.disabled = false;
            this.elements.increaseQtyBtn.disabled = false;
        }

        this.elements.stockBadge.textContent = stock > 0 ? 'Em Estoque' : 'Indisponível';
        this.elements.stockBadge.classList.toggle('out-of-stock', stock <= 0);

        this.updateGallery(details.images);
        this.updateAddToCartButtonState();
      },

      updateGallery(images) {
        const imagesToDisplay = images.slice(0, 5);
        if (imagesToDisplay.length === 0) return;

        // Verifica se a galeria atual é diferente da nova
        const currentThumbs = Array.from(this.elements.galleryThumbnails.querySelectorAll('.thumbnail')).map(t => t.dataset.imgSrc);
        const isDifferent = JSON.stringify(currentThumbs) !== JSON.stringify(imagesToDisplay);

        if (isDifferent) {
            this.elements.galleryThumbnails.innerHTML = '';
            
            // Transition main image
            this.elements.mainImage.style.opacity = '0.5';
            setTimeout(() => {
                this.elements.mainImage.src = imagesToDisplay[0];
                this.elements.mainImage.style.opacity = '1';
            }, 150);

            imagesToDisplay.forEach((imgSrc, idx) => {
              const thumb = document.createElement('img');
              thumb.className = `thumbnail ${idx === 0 ? 'active' : ''}`;
              thumb.src = imgSrc;
              thumb.dataset.imgSrc = imgSrc;
              thumb.alt = `Product view ${idx + 1}`;
              this.elements.galleryThumbnails.appendChild(thumb);
            });
        }
      },

      updatePillStates() {
        const variations = this.state.product.variacoes || [];
        if (variations.length === 0) return;

        const { selectedColor, selectedSize } = this.state;

        const update = (selector, type) => {
          if (!selector) return;
          Array.from(selector.children).forEach(pill => {
            const value = pill.dataset.value;
            const isAvailable = variations.some(v => {
              if (!v.ativo || v.estoque <= 0) return false;

              if (type === 'color') {
                const matchesColor = v.cores?.includes(value);
                const matchesSelectedSize = !selectedSize || v.tamanhos?.includes(selectedSize);
                return matchesColor && matchesSelectedSize;
              }

              if (type === 'size') {
                const matchesSize = v.tamanhos?.includes(value);
                const matchesSelectedColor = !selectedColor || v.cores?.includes(selectedColor);
                return matchesSize && matchesSelectedColor;
              }

              return false;
            });
            pill.classList.toggle('disabled', !isAvailable);
          });
        };

        update(this.elements.colorSelector, 'color');
        update(this.elements.sizeSelector, 'size');
      },

      updateAddToCartButtonState() {
        const btn = this.elements.addToCartBtn;
        if (!btn) return;

        const variations = this.state.product.variacoes || [];
        if (variations.length === 0) {
            const stock = this.state.product.estoque || 0;
            btn.disabled = stock <= 0;
            btn.innerHTML = `<i class="material-icons">shopping_cart</i> ${stock > 0 ? 'Adicionar ao Carrinho' : 'Produto Indisponível'}`;
            return;
        }

        const needsColor = this.elements.colorSelector && !this.state.selectedColor;
        const needsSize = this.elements.sizeSelector && !this.state.selectedSize;

        if (needsColor || needsSize) {
          btn.disabled = true;
          btn.innerHTML = '<i class="material-icons">shopping_cart</i> Selecione as opções';
          return;
        }

        const details = this.getVariationDetails();
        const stock = details.stock;
        btn.disabled = stock <= 0;
        btn.innerHTML = `<i class="material-icons">shopping_cart</i> ${stock > 0 ? 'Adicionar ao Carrinho' : 'Variação Indisponível'}`;
      },

      handleAddToCart() {
        const details = this.getVariationDetails();
        const stock = Number(details.stock || 0);
        const qty = parseInt(this.elements.quantityInput.value, 10);

        if (stock <= 0) {
          if (typeof showNotification === 'function') showNotification('A variação selecionada está fora de estoque.', 'error');
          else alert('A variação selecionada está fora de estoque.');
          return;
        }
        
        if (qty <= 0 || qty > stock) {
          if (typeof showNotification === 'function') showNotification(`Quantidade inválida. Máximo disponível: ${stock}`, 'error');
          else alert(`Por favor, insira uma quantidade válida (1-${stock}).`);
          return;
        }

        const { selectedColor, selectedSize } = this.state;
        
        const cartItem = {
            id: this.state.product._id,
            nome: this.state.product.nome,
            preco: details.price,
            quantidade: qty,
            cor: selectedColor,
            tamanho: selectedSize,
            imagem: details.images[0],
            variationId: details.variation ? details.variation._id : null
        };

        this.addToCart(cartItem);
        
        if (typeof showNotification === 'function') {
            showNotification(`${qty} unidade(s) adicionadas ao carrinho!`, 'success');
        } else {
            alert(`Adicionado ${qty} unidade(s) ao carrinho!`);
        }
      },

      addToCart(item) {
          let cart = JSON.parse(localStorage.getItem('cart') || '[]');
          
          const existingIndex = cart.findIndex(i => 
              i.id === item.id && 
              i.cor === item.cor && 
              i.tamanho === item.tamanho &&
              i.variationId === item.variationId
          );

          if (existingIndex > -1) {
              cart[existingIndex].quantidade += item.quantidade;
          } else {
              cart.push(item);
          }

          localStorage.setItem('cart', JSON.stringify(cart));
          window.dispatchEvent(new CustomEvent('cartUpdated', { detail: { cart } }));
      },

      applyColorSwatches() {
        const colorMap = { 'vermelho': '#FF0000', 'azul': '#0000FF', 'verde': '#008000', 'preto': '#000000', 'branco': '#FFFFFF', 'amarelo': '#FFFF00', 'laranja': '#FFA500', 'roxo': '#800080', 'rosa': '#FFC0CB', 'cinza': '#808080' };
        document.querySelectorAll('.pill-option-color').forEach(pill => {
          const colorName = pill.dataset.value.toLowerCase();
          const swatch = pill.querySelector('.color-swatch');
          if (swatch) {
            const hexColor = colorMap[colorName];
            swatch.style.backgroundColor = hexColor || colorName;
            if (colorName === 'branco' || hexColor === '#FFFFFF') {
              swatch.style.border = '1px solid #ccc';
            }
          }
        });
      },
    };

    App.init();
  });
</script>

<script src="/js/favorited.js"></script>