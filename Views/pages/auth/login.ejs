<link rel="stylesheet" href="/css/pages/login.css">
<section class="login-page">
  <div class="login-container">
    <h1 class="login-title">
      <%= titulo %>
    </h1>
    <p class="login-message">
      <%= message %>
    </p>

    <form id="loginForm" class="login-form">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="form-group">
        <label for="email">E-mail ou Usuário</label>
        <div class="input-with-icon">
          <i class="material-icons">person_outline</i>
          <input type="text" id="email" name="email" placeholder="Seu e-mail ou usuário" required>
        </div>
      </div>
      <div class="form-group">
        <label for="password">Senha</label>
        <div class="input-with-icon">
          <i class="material-icons">lock_outline</i>
          <input type="password" id="password" name="password" placeholder="Sua senha" required>
        </div>
      </div>
      <div class="form-options">
        <div class="remember-me">
          <input type="checkbox" id="rememberMe" name="rememberMe">
          <label for="rememberMe">Lembrar-me</label>
        </div>
        <a href="/reset-password" class="forgot-password-link" hx-get="/reset-password" hx-target="#main-content"
          hx-swap="innerHTML" hx-push-url="true">Esqueceu a senha?</a>
      </div>
      <button type="submit" class="btn-primary">Entrar</button>
    </form>

    <script src="/js/login.js"></script>

    <p class="register-prompt">Não tem uma conta? <a href="/register" class="register-link" hx-get="/register"
        hx-target="#main-content" hx-swap="innerHTML" hx-push-url="true">Crie uma agora!</a></p>
  </div>
</section>