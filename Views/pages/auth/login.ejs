<style>
  .login-page {
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 78vh; /* Ajuste conforme a altura do seu header */
    background-color: var(--cor-fundo-site);
    padding: var(--espacamento-grande);
  }

  .login-container {
    background-color: #fff;
    padding: 3rem 2.5rem;
    border-radius: 16px;
    box-shadow: var(--sombra-suave);
    width: 100%;
    max-width: 430px;
    text-align: center;
  }

  .login-title {
    color: var(--cor-primaria);
    margin-bottom: 0.5rem;
    font-size: 1.8rem;
    font-family: var(--fonte-titulo);
  }

  .login-message {
    color: var(--cor-texto-medio);
    margin-bottom: var(--espacamento-grande);
  }

  .login-form .form-group {
    margin-bottom: 1.5rem;
    text-align: left;
    position: relative;
  }

  .login-form label {
    display: block;
    margin-bottom: var(--espacamento-xs);
    color: var(--cor-texto-escuro);
    font-weight: 600;
    font-size: 0.9rem;
  }

  .input-with-icon {
    position: relative;
    display: flex;
    align-items: center;
  }

  .input-with-icon i {
    position: absolute;
    left: 12px;
    color: #999;
    font-size: 20px;
  }

  .login-form input[type="text"],
  .login-form input[type="password"] {
    width: 100%;
    padding: 0.8rem 1rem 0.8rem 2.5rem;
    border: 1px solid var(--cor-borda);
    border-radius: 8px;
    box-sizing: border-box; /* Garante que padding não aumente a largura total */
    font-size: 1rem;
    transition: var(--transicao-suave);
    background-color: #fafafa;
  }

  .login-form input[type="text"]:focus,
  .login-form input[type="password"]:focus {
    border-color: var(--cor-primaria);
    outline: none;
    background-color: #fff;
    box-shadow: 0 0 0 4px rgba(var(--cor-primaria-rgb, 0, 0, 0), 0.1);
  }

  .login-form input:focus + i {
    color: var(--cor-primaria);
  }

  .form-options {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin: 0.5rem 0 1.5rem;
    font-size: 0.9rem;
  }

  .remember-me {
    display: flex;
    align-items: center;
    cursor: pointer;
  }

  .remember-me input {
    margin-right: var(--espacamento-pequeno);
    cursor: pointer;
  }

  .forgot-password-link,
  .register-link {
    color: var(--cor-primaria);
    text-decoration: none;
    font-weight: 600;
    transition: color 0.2s ease;
  }

  .forgot-password-link:hover,
  .register-link:hover {
    text-decoration: underline;
    color: var(--cor-secundaria);
  }

  .btn-primary {
    background-color: var(--cor-secundaria);
    color: var(--cor-texto-claro);
    padding: 1rem var(--espacamento-md);
    border: none;
    border-radius: 8px;
    cursor: pointer;
    font-size: 0.95rem;
    font-weight: bold;
    transition: all 0.3s ease;
    width: 100%;
    margin-top: 0.5rem;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 8px;
  }

  .btn-primary:hover {
    filter: brightness(110%);
    transform: translateY(-2px);
    box-shadow: 0 6px 15px rgba(0, 0, 0, 0.15);
  }

  .btn-primary:active {
    transform: translateY(0);
  }

  .btn-primary:disabled {
    background-color: #ccc;
    cursor: not-allowed;
    transform: none;
  }

  .register-prompt {
    margin-top: var(--espacamento-grande);
    color: var(--cor-texto-medio);
  }
</style>

<section class="login-page">
  <div class="login-container">
    <h1 class="login-title"><%= titulo %></h1>
    <p class="login-message"><%= message %></p>

    <form id="loginForm" class="login-form">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="form-group">
        <label for="email">E-mail ou Usuário</label>
        <div class="input-with-icon">
          <i class="material-icons">person_outline</i>
          <input type="text" id="email" name="email" placeholder="Seu e-mail ou usuário" required>
        </div>
      </div>
      <div class="form-group">
        <label for="password">Senha</label>
        <div class="input-with-icon">
          <i class="material-icons">lock_outline</i>
          <input type="password" id="password" name="password" placeholder="Sua senha" required>
        </div>
      </div>
      <div class="form-options">
        <div class="remember-me">
          <input type="checkbox" id="rememberMe" name="rememberMe">
          <label for="rememberMe">Lembrar-me</label> 
        </div>
        <a href="/reset-password" class="forgot-password-link" hx-get="/reset-password" hx-target="#main-content" hx-swap="innerHTML" hx-push-url="true">Esqueceu a senha?</a>
      </div>
      <button type="submit" class="btn-primary">Entrar</button>
    </form>

    <script>
      document.getElementById('loginForm').addEventListener('submit', async function(e) {
        e.preventDefault();
        
        const form = e.target;
        const btn = form.querySelector('.btn-primary');
        const formData = new URLSearchParams(new FormData(form));
        
        btn.disabled = true;
        const originalText = btn.innerHTML;
        btn.innerHTML = 'Entrando...';

        try {
            const response = await fetch('/login', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/x-www-form-urlencoded'
            },
            body: formData.toString()
          });
          
          const contentType = response.headers.get("content-type");
          let result;
          if (contentType && contentType.includes("application/json")) {
            result = await response.json();
          } else {
            result = await response.text();
          }
          
          if (response.ok) {
            console.log('Login com sucesso:', result);
            if (typeof showNotification === 'function') {
                showNotification('Login realizado com sucesso!', 'success');
            } else {
                alert('Login realizado!');
            }
            if (result.user && result.user.email && !result.user.email.verified) {
                window.location.href = '/verify-otp'; 
            } else {
                window.location.href = '/profile'; // Ou para a página inicial '/'
            }
          } else {
            console.error('Erro no login:', result);
            if (typeof showNotification === 'function') {
                showNotification(result.message || 'Erro ao realizar login', 'error');
            } else {
                alert(result.message || 'Erro ao realizar login');
            }
          }
        } catch (error) {
          console.error('Erro de rede:', error);
          if (typeof showNotification === 'function') {
              showNotification('Erro de conexão ao tentar fazer login.', 'error');
          } else {
              alert('Erro de conexão ao tentar fazer login.');
          }
        }
      });
    </script>

    <p class="register-prompt">Não tem uma conta? <a href="/register" class="register-link" hx-get="/register" hx-target="#main-content" hx-swap="innerHTML" hx-push-url="true">Crie uma agora!</a></p>
  </div>
</section>