<style>
  .profile-page {
    display: flex;
    justify-content: center;
    padding: var(--espacamento-grande);
    background-color: #f4f7f6;
    min-height: 78vh;
  }

  .profile-container {
    width: 100%;
    margin-top: 20px;
    max-width: 1200px;
    background-color: transparent;
    padding: var(--espacamento-grande);
  }

  .profile-title {
    color: var(--cor-primaria);
    font-family: var(--fonte-titulo);
    margin-bottom: var(--espacamento-sm);
    text-align: center;
    font-weight: 700;
    font-size: 1.8rem;
  }

  .profile-message {
    color: var(--cor-texto-medio);
    text-align: center;
    margin-bottom: var(--espacamento-lg);
  }

  .profile-content {
    display: flex;
    flex-direction: column;
    gap: var(--espacamento-grande);
  }
  .profile-content div{

    margin: 14px;

  }

  .user-info-card,
  .user-orders-card {
    background-color: #fff;
    border: 1px solid var(--cor-borda);
    border-radius: var(--raio-grande);
    padding: var(--espacamento-lg);
    box-shadow: var(--sombra-suave);
  }

  .user-info-card h2,
  .user-orders-card h2 {
    color: var(--cor-primaria);
    margin-bottom: var(--espacamento-grande);
    font-size: 1.25rem;
    display: flex;
    align-items: center;
    gap: var(--espacamento-sm);
    border-bottom: 2px solid var(--cor-fundo-site);
    padding-bottom: var(--espacamento-md);
  }

  .profile-avatar-container {
    display: flex;
    justify-content: center;
    margin-bottom: var(--espacamento-grande);
  }

  .profile-avatar {
    width: 80px;
    height: 80px;
    background: linear-gradient(135deg, var(--cor-primaria), #333);
    color: white;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 2.2rem;
    font-weight: bold;
    box-shadow: var(--sombra-media);
    border: 3px solid #fff;
  }

  .info-group {
    margin-bottom: 1.2rem;
    display: flex;
    flex-direction: column;
  }

  .info-group label {
    color: var(--cor-texto-suave);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .info-group p {
    color: #444;
    margin: 0;
    font-size: 1rem;
    font-weight: 500;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    word-break: break-all;
  }

  .badge {
    font-size: 0.7rem;
    padding: 4px 10px;
    border-radius: 20px;
    color: white;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.3px;
  }

  .badge.verified {
    background-color: var(--cor-sucesso);
    box-shadow: 0 2px 5px rgba(46, 204, 113, 0.2);
  }

  .badge.unverified {
    background-color: var(--cor-erro);
  }

  .btn-logout {
    display: block;
    width: 100%;
    border: 2px solid var(--cor-destaque);
    color: var(--cor-destaque);
    background-color: transparent;
    padding: 12px;
    text-decoration: none;
    border-radius: 8px;
    font-weight: 600;
    transition: background-color 0.3s;
    text-align: center;
  }

  .btn-logout:hover {
    background-color: var(--cor-destaque);
    color: #fff;
  }

  .orders-list {
    list-style-type: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--espacamento-md);
  }

  .order-item {
    background-color: #fff;
    border: 1px solid var(--cor-borda);
    border-radius: var(--raio-padrao);
    padding: var(--espacamento-md);
    display: flex;
    flex-direction: column;
    gap: var(--espacamento-sm);
    transition: var(--transicao-suave);
  }

  .order-item:hover {
    transform: translateY(-2px);
    box-shadow: var(--sombra-media);
    border-color: var(--cor-borda-forte);
  }

  .order-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: var(--espacamento-xs);
    margin-bottom: 4px;
    border-bottom: 1px solid var(--cor-fundo-site);
  }

  .order-header strong {
    color: var(--cor-texto-escuro);
    font-size: 1rem;
  }

  .order-date {
    color: var(--cor-texto-escuro);
    font-size: 0.9rem;
  }

  .order-details {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .order-status {
    font-weight: 600;
    color: var(--cor-alerta);
    background-color: #fffaf0;
    border: 1px solid #feebc8;
    padding: 6px 12px;
    border-radius: 6px;
    font-size: 0.75rem;
  }

  .order-total {
    font-weight: bold;
    color: var(--cor-primaria);
    font-size: 1.1rem;
  }

  .no-orders {
    color: var(--cor-texto-suave);
    font-style: italic;
    background-color: var(--cor-fundo-site);
    padding: var(--espacamento-lg);
    border-radius: var(--raio-padrao);
    border: 2px dashed var(--cor-borda-forte);
    text-align: center;
    margin-top: var(--espacamento-md);
  }

  @media (min-width: 768px) {
    .profile-content {
      flex-direction: row;
      align-items: flex-start;
    }

    .user-info-card {
      flex: 1;
      position: sticky;
      top: 20px;
    }

    .user-orders-card {
      flex: 2;
    }
  }

  @media (max-width: 600px) {
    .user-info-card,
    .user-orders-card {
      padding: var(--espacamento-medio);
    }

    .profile-title {
      margin: var(--espacamento-medio);
    }

    .profile-container {
      padding: 0px;
      margin: 15px;
      border: none;
      box-shadow: none;
    }
  }
</style>

<section class="profile-page">
  <div class="profile-container">
    <h1 class="profile-title">
      <%= titulo %>
    </h1>

    <div class="profile-content">
      <div class="user-info-card">
        <div class="profile-avatar-container">
          <div class="profile-avatar">
            <%= user?.name ? user.name.charAt(0).toUpperCase() : 'U' %>
          </div>
        </div>
        
        <h2>Informações do Usuário</h2>
        <div class="info-group">
          <label>Nome:</label>
          <p>
            <%= user?.name || 'Não informado' %>
          </p>
        </div>
        <div class="info-group">
          <label>Email:</label>
          <p>
            <%= user?.email?.endereco || 'Não informado' %>
              <% if (user?.email?.endereco) { %>
                <span class="badge <%= user?.email?.verified ? 'verified' : 'unverified' %>">
                  <%= user?.email?.verified ? 'Verificado' : 'Não verificado' %>
                </span>
                <% } %>
          </p>
        </div>
        <div class="info-group">
          <label>Telefone:</label>
          <p>
            <%= user?.phone?.number || 'Não informado' %>
              <% if (user?.phone?.number) { %>
                <span class="badge <%= user?.phone?.verified ? 'verified' : 'unverified' %>">
                  <%= user?.phone?.verified ? 'Verificado' : 'Não verificado' %>
                </span>
                <% } %>
          </p>
        </div>
        <div class="info-group">
          <label>Cargo:</label>
          <p>
            <%= user?.role ==='admin' ? 'Administrador' : 'Usuário' %>
          </p>
        </div>
        <div class="profile-actions" style="margin-top: 1rem;">
          <a href="/logout" class="btn-logout">Sair da Conta</a>
        </div>
      </div>

      <div class="user-orders-card">
        <h2>Meus Pedidos</h2>
        <% if (user?.orderns && user.orderns.length> 0) { %>
          <ul class="orders-list">
            <% user.orderns.forEach(order=> { %>
              <li class="order-item">
                <div class="order-header">
                  <strong>Pedido #<%= order._id || order.id || 'N/A' %></strong>
                  <span class="order-date">
                    <%= new Date(order.createdAt || order.date || Date.now()).toLocaleDateString('pt-BR') %>
                  </span>
                </div>
                <div class="order-details">
                  <div class="order-status">Status: <%= order.status || 'Processando' %>
                  </div>
                  <div class="order-total">Total: R$ <%= (order.total || 0).toFixed(2) %>
                  </div>
                </div>
              </li>
              <% }) %>
          </ul>
          <% } else { %>
            <p class="no-orders">Você ainda não realizou nenhum pedido.</p>
            <% } %>
      </div>
    </div>
  </div>
</section>