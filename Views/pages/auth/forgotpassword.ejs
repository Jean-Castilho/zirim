

<style>
    /* Layout Geral */
    .forgot-password-page {
        min-height: 85vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 1.5rem 3rem;
    }

    .auth-card {
        max-width: 28rem;
        width: 100%;
        background-color: #18181b;
        /* zinc-900 */
        border: 1px solid #27272a;
        /* zinc-800 */
        padding: 2.5rem;
        border-radius: 1.5rem;
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
    }

    .auth-header {
        text-align: center;
        margin-bottom: 2.5rem;
    }

    .auth-title {
        color: white;
        font-size: 1.5rem;
        font-weight: 700;
        margin-bottom: 0.5rem;
    }

    .auth-subtitle {
        color: #a1a1aa;
        font-size: 0.875rem;
    }

    /* Formulário */
    .auth-form {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
    }

    .form-group {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    .form-label {
        color: #d4d4d8;
        font-size: 0.875rem;
        font-weight: 500;
    }

    .form-input {
        padding: 0.875rem 1.25rem;
        border-radius: 1rem;
        background-color: rgba(39, 39, 42, 0.5);
        border: 1px solid #3f3f46;
        color: white;
        transition: all 0.2s;
    }

    .form-input:focus {
        outline: none;
        border-color: rgba(255, 255, 255, 0.3);
    }

    /* Botão e Estados HTMX */
    .submit-btn {
        width: 100%;
        padding: 1rem;
        background-color: white;
        color: black;
        font-weight: 700;
        border-radius: 1rem;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.75rem;
        transition: all 0.2s;
        cursor: pointer;
        border: none;
    }

    .submit-btn:hover {
        background-color: #e4e4e7;
    }

    .submit-btn:active {
        transform: scale(0.98);
    }

    .htmx-indicator {
        display: none;
        width: 1.25rem;
        height: 1.25rem;
    }

    .htmx-request .htmx-indicator {
        display: block;
    }

    .htmx-request .indicator-label {
        display: none;
    }

    .htmx-request button {
        opacity: 0.8;
        pointer-events: none;
    }

    /* Rodapé e Feedback */
    .auth-footer {
        margin-top: 2.5rem;
        padding-top: 2rem;
        border-top: 1px solid #27272a;
        text-align: center;
    }

    .back-link {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        color: #71717a;
        font-size: 0.875rem;
        text-decoration: none;
        transition: color 0.2s;
    }

    .back-link:hover {
        color: white;
    }

    .back-icon {
        width: 1rem;
        height: 1rem;
        transition: transform 0.2s;
    }

    .back-link:hover .back-icon {
        transform: translateX(-4px);
    }

    #feedback-msg {
        min-height: 1.25rem;
        font-size: 0.875rem;
        transition: all 0.3s;
    }

    #feedback-msg:empty {
        opacity: 0;
        transform: translateY(-5px);
    }

    #feedback-msg:not(:empty) {
        opacity: 1;
        transform: translateY(0);
    }
</style>

<div class="forgot-password-page">
    <div class="auth-card">
        <div class="auth-header">
            <h1 class="auth-title">
                <%= titulo %>
            </h1>
            <p class="auth-subtitle">
                <%= message %>
            </p>
        </div>

        <form id="forgot-password-form" action="/forgotPassword" method="POST" class="auth-form">

            <!-- Token CSRF para segurança -->
            <input type="hidden" name="_csrf" value="<%= locals.csrfToken %>">

            <div class="form-group">
                <label for="email" class="form-label">Endereço de E-mail</label>
                <input type="email" id="email" name="email" required placeholder="seu@email.com" class="form-input">
            </div>

            <div id="feedback-msg"></div>

            <button type="submit" class="submit-btn group">
                <span class="uppercase tracking-widest text-xs">Enviar Link de Redefinição</span>
            </button>
        </form>

        <div class="auth-footer">
            <a href="/login" class="back-link">
                <svg xmlns="http://www.w3.org/2000/svg" class="back-icon" fill="none" viewBox="0 0 24 24"
                    stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M10 19l-7-7m0 0l7-7m-7 7h18" />
                </svg>
                Voltar para o Login
            </a>
        </div>
    </div>
</div>
