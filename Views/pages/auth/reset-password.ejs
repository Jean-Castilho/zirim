<style>
    /* Layout Geral */
    .forgot-password-page {
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 78vh;
        background-color: var(--cor-fundo-site);
        padding: var(--espacamento-grande);
    }

    .auth-card {
        background-color: #fff;
        padding: 3rem 2.5rem;
        border-radius: 16px;
        box-shadow: var(--sombra-suave);
        width: 100%;
        max-width: 430px;
        text-align: center;
    }

    .auth-header {
        text-align: center;
        margin-bottom: 2.5rem;
    }

    .auth-title {
        color: var(--cor-primaria);
        margin-bottom: 0.5rem;
        font-size: 1.8rem;
        font-family: var(--fonte-titulo);
    }

    .auth-subtitle {
        color: var(--cor-texto-medio);
        margin-bottom: var(--espacamento-grande);
    }

    /* Formulário */
    .auth-form {
        display: flex;
        flex-direction: column;
    }

    .form-group {
        display: flex;
        flex-direction: column;
        margin-bottom: 1.5rem;
        text-align: left;
        position: relative;
    }

    .form-label {
        display: block;
        margin-bottom: var(--espacamento-xs);
        color: var(--cor-texto-escuro);
        font-weight: 600;
        font-size: 0.9rem;
    }

    .input-with-icon {
        position: relative;
        display: flex;
        align-items: center;
    }

    .input-with-icon i {
        position: absolute;
        left: 12px;
        color: #999;
        font-size: 20px;
    }

    .form-input {
        width: 100%;
        padding: 0.8rem 1rem 0.8rem 2.5rem;
        border: 1px solid var(--cor-borda);
        border-radius: 8px;
        box-sizing: border-box;
        font-size: 1rem;
        transition: var(--transicao-suave);
        background-color: #fafafa;
        color: var(--cor-texto-escuro);
    }

    .form-input:focus {
        border-color: var(--cor-primaria);
        outline: none;
        background-color: #fff;
        box-shadow: 0 0 0 4px rgba(var(--cor-primaria-rgb, 0, 0, 0), 0.1);
    }

    .form-input:focus + i {
        color: var(--cor-primaria);
    }

    /* Botão e Estados HTMX */
    .submit-btn {
        background-color: var(--cor-secundaria);
        color: var(--cor-texto-claro);
        padding: 1rem var(--espacamento-md);
        border: none;
        border-radius: 8px;
        cursor: pointer;
        font-size: 0.95rem;
        font-weight: bold;
        transition: all 0.3s ease;
        width: 100%;
        margin-top: 0.5rem;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.75rem;
    }

    .submit-btn:hover {
        filter: brightness(110%);
        transform: translateY(-2px);
        box-shadow: 0 6px 15px rgba(0, 0, 0, 0.15);
    }

    .submit-btn:active {
        transform: translateY(0);
    }

    .htmx-request button {
        opacity: 0.8;
        pointer-events: none;
    }

    /* Rodapé e Feedback */
    .auth-footer {
        margin-top: var(--espacamento-grande);
        padding-top: 1.5rem;
        border-top: 1px solid var(--cor-borda);
        text-align: center;
    }

    .back-link {
        color: var(--cor-primaria);
        text-decoration: none;
        font-weight: 600;
        transition: color 0.2s ease;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
    }

    .back-link:hover {
        text-decoration: underline;
        color: var(--cor-secundaria);
    }

    .back-icon {
        width: 1rem;
        height: 1rem;
        transition: transform 0.2s;
    }

    .back-link:hover .back-icon {
        transform: translateX(-4px);
    }

    #feedback-msg {
        min-height: 1.25rem;
        font-size: 0.875rem;
        transition: all 0.3s;
    }

    #feedback-msg:empty {
        opacity: 0;
        transform: translateY(-5px);
    }

    #feedback-msg:not(:empty) {
        opacity: 1;
        transform: translateY(0);
    }
</style>

<div class="forgot-password-page">
    <div class="auth-card">
        <div class="auth-header">
            <h1 class="auth-title">
                <%= titulo %>
            </h1>
            <p class="auth-subtitle">
                <%= message %>
            </p>
        </div>

        <form id="forgot-password-form" action="/forgotPassword" method="POST" class="auth-form">

            <!-- Token CSRF para segurança -->
            <input type="hidden" name="_csrf" value="<%= locals.csrfToken %>">

            <div class="form-group">
                <label for="email" class="form-label">E-mail</label>
                <div class="input-with-icon">
                    <i class="material-icons">mail_outline</i>
                    <input type="email" id="email" name="email" required placeholder="seu@email.com" class="form-input">
                </div>
            </div>

            <div id="feedback-msg"></div>

            <button type="submit" class="submit-btn group">
                <span class="indicator-label">Enviar Link de Redefinição</span>
            </button>
        </form>

        <div class="auth-footer">
            <a href="/login" class="back-link" hx-get="/login" hx-target="#main-content" hx-swap="innerHTML" hx-push-url="true">
                <svg xmlns="http://www.w3.org/2000/svg" class="back-icon" fill="none" viewBox="0 0 24 24"
                    stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M10 19l-7-7m0 0l7-7m-7 7h18" />
                </svg>
                Voltar para o Login
            </a>
        </div>
    </div>
</div>
