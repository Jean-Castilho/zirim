<link rel="stylesheet" href="/css/pages/admin-dashboard.css">
<div class="dashboard-container">
    <header class="dashboard-header">
        <div class="header-info">
            <h1><%= titulo %></h1>
            <p><%= message %></p>
        </div>

        <div class="u-display-flex-gap-0-75rem-flex-wrap-wrap">
            <a href="/inventory/add" class="btn-primary">
                <i data-lucide="plus-circle"></i>
                Novo Produto
            </a>
            <a href="/edit/home" class="btn-secondary">
                <i data-lucide="home"></i>
                Editar Home
            </a>
        </div>
    </header>

    <section class="stats-grid">
        <div class="stat-card">
            <div class="stat-header">
                <div class="icon-box"><i data-lucide="package"></i></div>
                <span class="badge-trend">+12%</span>
            </div>
            <div class="stat-label">Total de Produtos</div>
            <div class="stat-value"><%= totalProducts %></div>
        </div>

        <div class="stat-card">
            <div class="stat-header">
                <div class="icon-box success"><i data-lucide="shopping-cart"></i></div>
            </div>
            <div class="stat-label">Vendas Mensais (30d)</div>
            <div class="stat-value">R$ <%= monthlySales.toLocaleString('pt-BR', { minimumFractionDigits: 2 }) %></div>
        </div>

        <div class="stat-card">
            <div class="stat-header">
                <div class="icon-box warning"><i data-lucide="truck"></i></div>
                <span class="badge-trend warning"><%= activeDeliveries %> pendentes</span>
            </div>
            <div class="stat-label">Entregas Ativas</div>
            <div class="stat-value"><%= activeDeliveries %></div>
        </div>

        <div class="stat-card">
            <div class="stat-header">
                <div class="icon-box danger"><i data-lucide="users"></i></div>
            </div>
            <div class="stat-label">Clientes Ativos</div>
            <div class="stat-value"><%= totalUsers %></div>
        </div>
    </section>

    <div class="main-grid">
        <aside class="panel">
            <div class="panel-header">
                <h2><i data-lucide="layers"></i> Gestão</h2>
            </div>
            <nav class="nav-list">
                <a href="/inventory" class="nav-item">
                    <span>Inventário</span>
                    <i data-lucide="chevron-right"></i>
                </a>
                <a href="/logistica" class="nav-item">
                    <span>Logística</span>
                    <i data-lucide="chevron-right"></i>
                </a>
                <a href="/users" class="nav-item">
                    <span>Usuários</span>
                    <i data-lucide="chevron-right"></i>
                </a>
            </nav>
        </aside>

        <main class="panel">
            <div class="panel-header">
                <h2>Últimas Atualizações</h2>
                <a class="u-color-var-accent-color-font-size-0-8-fbd132" href="/inventory">Ver tudo</a>
            </div>
            <div class="u-overflow-x-auto">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Imagem</th>
                            <th>Produto</th>
                            <th>Categoria</th>
                            <th class="u-text-align-right">Preço</th>
                            <th class="u-text-align-center">Status</th>
                        </tr>
                    </thead>
                    <tbody id="latest-products-rows">
                        <% latestProducts.forEach(product => { %>
                            <tr>
                                <td>
                                    <% if (product.variacoes && product.variacoes.length > 0 && product.variacoes[0].imagens && product.variacoes[0].imagens.length > 0) { %>
                                        <img class="u-width-45px-height-45px-object-fit-co-fd9367" src="/image/<%= product.variacoes[0].imagens[0] %>" alt="<%= product.nome %>">
                                    <% } else { %>
                                        <div class="u-width-45px-height-45px-background-va-facb5e">
                                            <i class="u-width-18px-color-var-text-secondary" data-lucide="image"></i>
                                        </div>
                                    <% } %>
                                </td>
                                <td class="u-color-var-text-primary-font-weight-500"><%= product.nome %></td>
                                <td><%= product.categoria || 'Geral' %></td>
                                <td class="u-text-align-right">R$ <%= (product.variacoes && product.variacoes.length > 0 ? product.variacoes[0].preco || 0 : 0).toLocaleString('pt-BR', { minimumFractionDigits: 2 }) %></td>
                                <td class="u-text-align-center"><span class="status-pill">Ativo</span></td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        </main>
    </div>
</div>

<script src="https://unpkg.com/lucide@latest"></script>
<script src="/js/admin-dashboard.js"></script>