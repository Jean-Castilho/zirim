<link rel="stylesheet" href="/css/pages/edit-home.css">
<div class="edit-home-container">
    <header class="edit-home-header">
        <div class="header-info">
            <h1>
                <%= titulo %>
            </h1>
            <p>
                <%= message %>
            </p>
        </div>
    </header>

    <div class="main-content">
        <div class="panel">
            <div class="panel-header">
                <h2>
                    <svg class="u-vertical-align-middle-margin-right-0-5rem" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none"
                        stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                       >
                        <rect x="3" y="3" width="18" height="18" rx="2" ry="2" />
                        <circle cx="8.5" cy="8.5" r="1.5" />
                        <polyline points="21 15 16 10 5 21" />
                    </svg>
                    Editar Banner Principal
                </h2>
            </div>
            <div class="panel-body">

                <form id="formUpdateBanner" action="/updateBannerHome" method="POST" enctype="multipart/form-data"
                    hx-post="/updateBannerHome" hx-encoding="multipart/form-data" hx-swap="none"
                    hx-disabled-elt="find .btn-submit" hx-indicator="#bannerSpinner">

                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">

                    <div class="form-group">
                        <label for="bannerTitle">Título do Banner</label>
                        <input type="text" id="bannerTitle" name="title" placeholder="Título chamativo para o banner"
                            value="<%= locals.homePageData?.banner?.title || '' %>">
                    </div>
                    <div class="form-group">
                        <label for="bannerDescription">Descrição do Banner</label>
                        <textarea id="bannerDescription" name="description"
                            placeholder="Uma breve descrição para o banner"><%= locals.homePageData?.banner?.description || '' %></textarea>
                    </div>
                    <div class="form-group form-group-checkbox">
                        <% const isButtonEnabled=locals.homePageData?.banner?.exibirBotao !==false; %>
                            <input type="checkbox" id="bannerExibirBotao" name="exibirBotao" value="true"
                                <%=isButtonEnabled ? 'checked' : '' %>>
                            <label for="bannerExibirBotao">
                                Habilitar botão principal no banner
                            </label>
                    </div>
                    <div class="form-group">
                        <label for="bannerButtonText">Texto do Botão</label>
                        <input type="text" id="bannerButtonText" name="textoBotao" placeholder="Ex: Ver Coleção"
                            value="<%= locals.homePageData?.banner?.textoBotao || '' %>">
                    </div>
                    <div class="form-group">
                        <label for="bannerLink">Link do Botão (URL de Destino)</label>
                        <input type="text" id="bannerLink" name="link"
                            placeholder="Ex: /products ou /products?category=calcados"
                            value="<%= locals.homePageData?.banner?.link || '' %>">
                    </div>
                    <div class="form-group">
                        <label for="bannerImage">Imagem do Banner</label>
                        <input type="file" id="bannerImage" name="bannerImage" accept="image/*">
                        <% let hasImage=Boolean(locals.homePageData?.banner?.imageUrl); let bgUrl=hasImage ? '/image/' +
                            locals.homePageData.banner.imageUrl : '' ; let
                            bannerTitleVal=locals.homePageData?.banner?.title || '' ; let
                            bannerDescVal=locals.homePageData?.banner?.description || '' ; let
                            bannerBtnVal=locals.homePageData?.banner?.textoBotao || 'Ver Coleção' ; %>
                            <div id="bannerHeroPreview" class="hero-preview <%= hasImage ? '' : 'no-image' %>"
                                data-bg-image="<%= bgUrl %>">
                                <div id="noImageWarning" class="preview-warning <%= hasImage ? 'u-display-none' : 'u-display-flex' %>">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"
                                        fill="none" stroke="var(--warning, #e67e22)" stroke-width="2"
                                        stroke-linecap="round" stroke-linejoin="round">
                                        <path
                                            d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z" />
                                        <line x1="12" y1="9" x2="12" y2="13" />
                                        <line x1="12" y1="17" x2="12.01" y2="17" />
                                    </svg>
                                    <span>Sem imagem de fundo</span>
                                </div>

                                <div class="hero-preview-content">
                                    <h1 id="previewTitle">
                                        <%= bannerTitleVal %>
                                    </h1>
                                    <p id="previewDescription">
                                        <%= bannerDescVal %>
                                    </p>
                                    <a href="/products" id="previewButton" class="btn <%= isButtonEnabled ? 'u-display-inline-flex' : 'u-display-none' %>" data-prevent-default>
                                        <%= bannerBtnVal %>
                                    </a>
                                </div>
                            </div>
                    </div>
                    <button type="submit" class="btn-submit">
                        <span class="btn-text">Salvar Alterações</span>
                        <span id="bannerSpinner" class="btn-spinner" aria-hidden="true"></span>
                    </button>
                </form>
            </div>
        </div>

        <!-- Painel de Gerenciamento do Banner de Categoria -->
        <div class="panel">
            <div class="panel-header">
                <h2>
                    <svg class="u-vertical-align-middle-margin-right-0-5rem" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none"
                        stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                       >
                        <rect x="3" y="3" width="7" height="7"></rect>
                        <rect x="14" y="3" width="7" height="7"></rect>
                        <rect x="14" y="14" width="7" height="7"></rect>
                        <rect x="3" y="14" width="7" height="7"></rect>
                    </svg>
                    Adicionar Banner / Card de Categoria
                </h2>
            </div>
            <div class="panel-body">

                <form id="formUpdateCategory" action="/updateCategoryHome" method="POST" enctype="multipart/form-data"
                    hx-post="/updateCategoryHome" hx-encoding="multipart/form-data" hx-swap="none"
                    hx-disabled-elt="find .btn-submit" hx-indicator="#categorySpinner">

                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">

                    <div class="form-group">
                        <label for="categoryTitle">Nome da Categoria</label>
                        <input type="text" id="categoryTitle" name="title"
                            placeholder="Ex: Moda, Calçados, Acessórios..." required>
                    </div>
                    <div class="form-group">
                        <label for="categoryLink">Link de Destino</label>
                        <input type="text" id="categoryLink" name="link" placeholder="Ex: /products?category=calcados"
                            required>
                    </div>
                    <div class="form-group">
                        <label for="categoryImage">Imagem da Categoria</label>
                        <input type="file" id="categoryImage" name="categoryImage" accept="image/*" required>

                        <div class="category-preview-card" id="categoryPreviewCard">
                            <span class="hero-preview-badge">
                                <span class="live-dot"></span>
                                Prévia ao vivo
                            </span>
                            <div id="noCategoryImageWarning" class="preview-warning u-display-flex">
                                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"
                                    fill="none" stroke="var(--warning, #e67e22)" stroke-width="2"
                                    stroke-linecap="round" stroke-linejoin="round">
                                    <path
                                        d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z" />
                                    <line x1="12" y1="9" x2="12" y2="13" />
                                    <line x1="12" y1="17" x2="12.01" y2="17" />
                                </svg>
                                <span>Sem imagem selecionada</span>
                            </div>
                            <img id="categoryPreviewImg"
                                src="https://images.unsplash.com/photo-1460353581641-37baddab0fa2?auto=format&fit=crop&w=400&q=80"
                                alt="Prévia da categoria">
                            <div class="category-card-content">
                                <h3 id="categoryPreviewTitle">Nome da Categoria</h3>
                                <a href="#" id="categoryPreviewLinkBtn" class="btn-submit btn-preview-action"
                                    data-prevent-default>Explorar</a>
                            </div>
                        </div>
                    </div>

                    <button type="submit" class="btn-submit">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none"
                            stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <line x1="12" y1="5" x2="12" y2="19"></line>
                            <line x1="5" y1="12" x2="19" y2="12"></line>
                        </svg>
                        <span class="btn-text">Adicionar Categoria ao Array</span>
                        <span id="categorySpinner" class="btn-spinner" aria-hidden="true"></span>
                    </button>

                </form>

                <% const savedCategories=locals.homePageData?.banner?.categories || []; %>
                    <% if (savedCategories.length> 0) { %>
                        <div class="categories-list-section">
                            <h3 class="categories-list-title">Categorias Cadastradas no Array (<%=
                                    savedCategories.length %>)</h3>
                            <div class="categories-grid">
                                <% savedCategories.forEach(cat=> {
                                    const catImg = cat.imageUrl?.startsWith('http') ? cat.imageUrl : ('/image/' +
                                    cat.imageUrl);
                                    %>
                                    <div class="category-preview-card category-card-item">
                                        <img src="<%= catImg %>" alt="<%= cat.title %>"
                                            data-fallback-src="https://images.unsplash.com/photo-1460353581641-37baddab0fa2?auto=format&fit=crop&w=400&q=80">
                                        <div class="category-card-content">
                                            <div class="category-card-details">
                                                <h3>
                                                    <%= cat.title %>
                                                </h3>
                                                <small>
                                                    <%= cat.link %>
                                                </small>
                                            </div>
                                            <form action="/deleteCategoryHome/<%= cat.id %>" method="POST"
                                                class="category-delete-form"
                                                data-confirm="Remover esta categoria do array?">
                                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                                <button type="submit" class="btn-delete-category" title="Remover">
                                                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18"
                                                        viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                                        stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                        <polyline points="3 6 5 6 21 6"></polyline>
                                                        <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2">
                                                        </path>
                                                    </svg>
                                                </button>
                                            </form>
                                        </div>
                                    </div>
                                    <% }) %>
                                        <a href="#formUpdateCategory" class="card-add-category"
                                            data-focus-target="categoryTitle">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32"
                                                viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                                stroke-linecap="round" stroke-linejoin="round">
                                                <line x1="12" y1="5" x2="12" y2="19"></line>
                                                <line x1="5" y1="12" x2="19" y2="12"></line>
                                            </svg>
                                            <span class="u-font-size-0-9rem-font-weight-600">Adicionar Novo</span>
                                        </a>
                            </div>
                        </div>
                        <% } %>
            </div>
        </div>

    </div>
</div>

<script src="/js/edit-home.js"></script>