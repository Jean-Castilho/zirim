<link rel="stylesheet" href="/css/pages/dashboard-logistica.css">
<input type="hidden" id="csrf-token" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">

<div class="logistica-container">
    <header class="logistica-header">
        <div>
            <h1><%= titulo %></h1>
            <p class="u-color-var-text-secondary"><%= message %></p>
        </div>
        <div class="u-display-flex-gap-10px-flex-wrap-wrap">
            <a href="/delivery/courier" class="btn-action u-background-var-accent-color">
                <i data-lucide="truck"></i> Painel do Entregador
            </a>
            <a href="/delivery" class="btn-action u-background-var-info">
                <i data-lucide="map"></i> Ver Mapa de Entregas
            </a>
        </div>
    </header>

    <section class="stats-grid">
        <div class="stat-card info">
            <span class="label">Total de Pedidos</span>
            <span class="value"><%= stats.total %></span>
        </div>
        <div class="stat-card warning">
            <span class="label">Aguardando Pagamento</span>
            <span class="value"><%= stats.pendente %></span>
        </div>
        <div class="stat-card u-border-left-4px-solid-d97706">
            <span class="label">Pagos (Aguardando Preparo)</span>
            <span class="value"><%= stats.pago %></span>
        </div>
        <div class="stat-card u-border-left-4px-solid-0284c7">
            <span class="label">Prontos / Em Rota</span>
            <span class="value"><%= (stats.preparado || 0) + (stats.em_rota || 0) %></span>
        </div>
        <div class="stat-card success">
            <span class="label">Entregues com Sucesso</span>
            <span class="value"><%= stats.entregue || 0 %></span>
        </div>
        <div class="stat-card accent">
            <span class="label">Faturamento Confirmado</span>
            <span class="value">R$ <%= stats.faturamento.toLocaleString('pt-BR', { minimumFractionDigits: 2 }) %></span>
        </div>
    </section>

    <main class="orders-panel">
        <div class="panel-header">
            <h2>Pedidos Recentes</h2>
            <div class="u-font-size-0-8rem-color-var-text-secondary">
                Mostrando <%= orders.length %> registros
            </div>
        </div>
        <div class="u-overflow-x-auto">
            <table class="orders-table">
                <thead>
                    <tr>
                        <th>ID Pedido</th>
                        <th>Data</th>
                        <th>Cliente</th>
                        <th>Total</th>
                        <th>Status</th>
                        <th>Entregador / PIN</th>
                        <th>Ações</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (orders && orders.length > 0) { %>
                        <% orders.forEach(order => { 
                            const shortId = order._id.toString().slice(-6).toUpperCase();
                            const status = order.statusInterno || 'pendente';
                            const courierName = order.delivery?.courierName || '';
                            const pinCode = order.delivery?.confirmationCodePlain || '';
                        %>
                            <tr id="order-row-<%= order._id %>">
                                <td class="u-font-weight-600">#<%= shortId %></td>
                                <td><%= order.createdAt ? new Date(order.createdAt).toLocaleDateString('pt-BR') : 'N/A' %></td>
                                <td>
                                    <div class="u-font-weight-500"><%= order.user?.name || 'Cliente Zirim' %></div>
                                    <div class="u-font-size-0-75rem-color-var-text-secondary"><%= order.user?.phone || '' %></div>
                                </td>
                                <td class="u-font-weight-600-color-var-accent-color">
                                    R$ <%= (order.payment?.transaction_amount || 0).toLocaleString('pt-BR', { minimumFractionDigits: 2 }) %>
                                </td>
                                <td>
                                    <span class="status-badge status-<%= status %>" id="status-badge-<%= order._id %>">
                                        <% if (status === 'pago') { %>
                                            Pago (Preparar)
                                        <% } else if (status === 'preparado') { %>
                                            Pronto p/ Retirada
                                        <% } else if (status === 'em_rota') { %>
                                            Em Rota
                                        <% } else if (status === 'entregue') { %>
                                            Entregue
                                        <% } else if (status === 'cancelado') { %>
                                            Cancelado
                                        <% } else if (status === 'expirado') { %>
                                            PIX Expirado
                                        <% } else { %>
                                            Aguard. Pgto
                                        <% } %>
                                    </span>
                                    <% if (order.inventoryProcessingFailed) { %>
                                        <small class="u-display-block-margin-top-5px-color-v-483b9d" role="alert">
                                            Revisar baixa de estoque
                                        </small>
                                    <% } %>
                                </td>
                                <td>
                                    <% if (pinCode) { %>
                                        <div class="u-display-flex-flex-direction-column-gap-3px">
                                            <span class="pin-badge" title="Código PIN gerado para o cliente">
                                                <i class="u-width-12px-height-12px" data-lucide="key"></i> <%= pinCode %>
                                            </span>
                                            <% if (courierName) { %>
                                                <small class="u-color-var-text-secondary-font-size-0-75rem">
                                                    <i class="u-width-12px-height-12px-vertical-align-middle" data-lucide="user-check"></i> <%= courierName %>
                                                </small>
                                            <% } %>
                                        </div>
                                    <% } else { %>
                                        <span class="u-color-var-text-secondary-font-size-0-75rem">-</span>
                                    <% } %>
                                </td>
                                <td>
                                    <div class="u-display-flex-gap-6px-align-items-center">
                                        <% if (status === 'pago') { %>
                                            <button 
                                                type="button" 
                                                class="btn-action btn-prepare" 
                                                id="btn-prepare-<%= order._id %>"
                                                data-action="prepare-order" data-order-id="<%= order._id %>"
                                                title="Liberar pedido para retirada pelo entregador"
                                            >
                                                <i class="u-width-13px-height-13px" data-lucide="package-check"></i> Preparar
                                            </button>
                                        <% } %>
                                        <a href="/checkout/<%= order._id %>" class="btn-action u-background-475569" title="Ver detalhes do pedido">
                                            <i class="u-width-13px-height-13px" data-lucide="eye"></i> Detalhes
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        <% }) %>
                    <% } else { %>
                        <tr>
                            <td class="u-padding-3rem-text-align-center-color-c37ca3" colspan="7">
                                <i class="u-width-40px-height-40px-display-block-6cf1af" data-lucide="package-x"></i>
                                Nenhum pedido registrado até o momento.
                            </td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </main>

    <a href="/dashboard" class="back-link">
        <i data-lucide="arrow-left"></i> Voltar ao Painel Geral
    </a>
</div>

<script src="https://unpkg.com/lucide@latest"></script>
<script src="/js/dashboard-logistica.js"></script>