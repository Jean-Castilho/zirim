<style>
  .admin-container {
    padding: 40px 20px;
    max-width: 1200px;
    margin: 0 auto;
  }

  .table-responsive {
    overflow-x: auto;
    background: white;
    border-radius: 8px;
    box-shadow: 0 4px 6px rgba(0,0,0,0.05);
  }

  .admin-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 30px;
    border-bottom: 2px solid var(--cor-borda);
    padding-bottom: 20px;
  }

  .admin-title {
    font-size: 2rem;
    color: var(--cor-primaria);
    margin-bottom: 5px;
  }

  .admin-table {
    width: 100%;
    border-collapse: collapse;
    text-align: left;
  }

  .admin-table thead {
    background-color: var(--cor-primaria);
    color: var(--cor-texto-claro);
  }

  .admin-table th {
    padding: 15px;
    border-bottom: 1px solid #ddd;
  }

  .admin-table tbody tr {
    border-bottom: 1px solid var(--cor-fundo-neutro);
    transition: background-color 0.2s;
  }

  .admin-table tbody tr:hover {
    background-color: #f9f9f9;
  }

  .admin-table td {
    padding: 15px;
  }

  .status-badge {
    padding: 5px 10px;
    border-radius: 20px;
    font-size: 0.85rem;
    font-weight: bold;
  }

  .status-active {
    background-color: #e8f5e9;
    color: #2e7d32;
  }

  .status-inactive {
    background-color: #ffebee;
    color: #c62828;
  }

  .role-badge {
    padding: 4px 8px;
    border-radius: 4px;
    font-size: 0.75rem;
    text-transform: uppercase;
    background-color: #f1f3f5;
    color: #495057;
  }

  .actions-wrapper {
    display: flex;
    justify-content: center;
    gap: 10px;
  }

  .btn-icon {
    background: none;
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 5px;
    border-radius: 4px;
    transition: background 0.2s;
  }

  .btn-icon i {
    font-size: 20px;
  }

  .btn-edit {
    color: #1976d2;
  }
  .btn-edit:hover {
    background-color: #e3f2fd;
  }

  .btn-delete {
    color: var(--cor-secundaria);
  }
  .btn-delete:hover {
    background-color: #ffebee;
  }

  .back-link-wrapper {
    margin-top: 20px;
    text-align: right;
  }

  .back-link {
    color: var(--cor-texto-escuro);
    text-decoration: none;
    font-weight: bold;
    display: inline-flex;
    align-items: center;
    gap: 5px;
  }

  .empty-state-cell {
    padding: 30px;
    text-align: center;
    color: #777;
  }

  .empty-state-cell i {
    font-size: 40px;
    color: #ccc;
    margin-bottom: 10px;
    display: block;
  }
</style>

<div class="admin-container">
  
  <header class="admin-header">
    <div>
      <h1 class="admin-title"><%= titulo %></h1>
      <p style="color: var(--cor-texto-medio);"><%= message %></p>
    </div>
  </header>

  <div class="table-responsive">
    <table class="admin-table">
      <thead>
        <tr>
          <th>Nome</th>
          <th>E-mail</th>
          <th>Telefone</th>
          <th>Função</th>
          <th>Status</th>
          <th style="text-align: center;">Ações</th>
        </tr>
      </thead>
      <tbody>
        <% if (users && users.length > 0) { %>
          <% users.forEach(user => { %>
            <tr>
              <td><%= user.name %></td>
              <td><%= user.email?.endereco || user.email %></td>
              <td><%= user.phone?.number || user.phone || 'N/A' %></td>
              <td>
                <span class="role-badge"><%= user.role || 'user' %></span>
              </td>
              <td>
                <span class="status-badge <%= user.isActive !== false ? 'status-active' : 'status-inactive' %>">
                  <%= user.isActive !== false ? 'Ativo' : 'Inativo' %>
                </span>
              </td>
              <td style="text-align: center;">
                <div class="actions-wrapper">
                  <a href="/admin/users/edit/<%= user._id %>" title="Editar" class="btn-icon btn-edit" style="text-decoration: none;">
                    <i class="material-icons">edit</i>
                  </a>
                  <button type="button" 
                          title="Desativar/Excluir" 
                          class="btn-icon btn-delete"
                          hx-delete="/api/users/<%= user._id %>"
                          hx-trigger="click"
                          hx-target="closest tr"
                          hx-swap="outerHTML swap:0.5s"
                          hx-confirm="Tem certeza que deseja desativar o usuário '<%= user.name %>'?">
                    <i class="material-icons">person_off</i>
                  </button>
                </div>
              </td>
            </tr>
          <% }) %>
        <% } else { %>
          <tr>
            <td colspan="6" class="empty-state-cell">
              <i class="material-icons">people_outline</i>
              Nenhum usuário encontrado.
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
  
  <div class="back-link-wrapper">
    <a href="/dashboard" class="back-link">
      <i class="material-icons" style="font-size: 18px;">arrow_back</i> Voltar ao Painel
    </a>
  </div>
</div>