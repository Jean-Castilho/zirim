<style>
    :root {
        --bg-main: var(--cor-fundo-site, #f8f9fa);
        --bg-card: var(--cor-fundo-claro, #ffffff);
        --border-color: var(--cor-borda, #e9ecef);
        --text-primary: var(--cor-texto-escuro, #212529);
        --text-secondary: var(--cor-texto-medio, #495057);
        --accent-color: var(--cor-secundaria, #e10732);
        --success: var(--cor-sucesso, #2b8a3e);
        --warning: var(--cor-alerta, #e67e22);
        --info: #0ea5e9;
    }

    .delivery-container {
        padding: 2rem;
        background-color: var(--bg-main);
        min-height: 100vh;
        font-family: 'Inter', sans-serif;
    }

    .delivery-header {
        margin-bottom: 2rem;
    }

    .delivery-header h1 {
        font-size: 1.875rem;
        font-weight: 700;
        color: var(--text-primary);
        margin: 0;
    }

    .stats-row {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 1.5rem;
        margin-bottom: 2rem;
    }

    .mini-stat-card {
        background: var(--bg-card);
        padding: 1.25rem;
        border-radius: 12px;
        border: 1px solid var(--border-color);
        display: flex;
        align-items: center;
        gap: 1rem;
    }

    .icon-circle {
        width: 48px;
        height: 48px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .main-content {
        display: grid;
        grid-template-columns: 1fr 350px;
        gap: 2rem;
    }

    #map-container {
        background: var(--bg-card);
        border-radius: 16px;
        border: 1px solid var(--border-color);
        overflow: hidden;
        height: 600px;
        position: relative;
    }

    #map {
        height: 100%;
        width: 100%;
    }

    .delivery-list-panel {
        background: var(--bg-card);
        border-radius: 16px;
        border: 1px solid var(--border-color);
        display: flex;
        flex-direction: column;
        max-height: 600px;
    }

    .panel-title {
        padding: 1.25rem;
        border-bottom: 1px solid var(--border-color);
        font-weight: 600;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .orders-scroll {
        overflow-y: auto;
        padding: 1rem;
    }

    .order-item {
        padding: 1rem;
        border-radius: 8px;
        border: 1px solid var(--border-color);
        margin-bottom: 0.75rem;
        cursor: pointer;
        transition: all 0.2s;
    }

    .order-item:hover {
        border-color: var(--accent-color);
        background: var(--cor-fundo-neutro, #f8f9fa);
    }

    .status-badge {
        font-size: 0.7rem;
        padding: 0.25rem 0.5rem;
        border-radius: 999px;
        text-transform: uppercase;
        font-weight: 700;
    }

    .status-transit { background: rgba(14, 165, 233, 0.1); color: var(--info); }
    .status-pending { background: rgba(230, 126, 34, 0.1); color: var(--warning); }

    @media (max-width: 1024px) {
        .main-content {
            grid-template-columns: 1fr;
        }
        #map-container { height: 400px; }
    }
</style>

<div class="delivery-container">
    <header class="delivery-header">
        <h1><i data-lucide="truck" style="vertical-align: middle; margin-right: 10px;"></i><%= titulo %></h1>
        <p><%= message %></p>
    </header>

    <section class="stats-row">
        <div class="mini-stat-card">
            <div class="icon-circle" style="background: rgba(14, 165, 233, 0.1); color: var(--info);">
                <i data-lucide="navigation"></i>
            </div>
            <div>
                <div style="font-size: 0.875rem; color: var(--text-secondary);">Em Rota</div>
                <div style="font-size: 1.25rem; font-weight: 700;">12</div>
            </div>
        </div>
        <div class="mini-stat-card">
            <div class="icon-circle" style="background: rgba(43, 138, 62, 0.1); color: var(--success);">
                <i data-lucide="check-circle"></i>
            </div>
            <div>
                <div style="font-size: 0.875rem; color: var(--text-secondary);">Concluídas (Hoje)</div>
                <div style="font-size: 1.25rem; font-weight: 700;">45</div>
            </div>
        </div>
        <div class="mini-stat-card">
            <div class="icon-circle" style="background: rgba(230, 126, 34, 0.1); color: var(--warning);">
                <i data-lucide="clock"></i>
            </div>
            <div>
                <div style="font-size: 0.875rem; color: var(--text-secondary);">Pendentes</div>
                <div style="font-size: 1.25rem; font-weight: 700;">8</div>
            </div>
        </div>
    </section>

    <div class="main-content">
        <!-- Coluna do Mapa -->
        <div id="map-container">
            <div class="panel-title" style="position: absolute; top: 0; left: 0; right: 0; z-index: 10; background: rgba(255,255,255,0.9); backdrop-filter: blur(4px);">
                <span>Visualização em Tempo Real</span>
                <div style="display: flex; gap: 5px;">
                    <button class="status-badge" style="border:1px solid var(--border-color); background: white;">Filtros</button>
                </div>
            </div>
            <div id="map"></div>
        </div>

        <!-- Coluna da Lista -->
        <aside class="delivery-list-panel">
            <div class="panel-title">
                <span>Entregas Ativas</span>
                <i data-lucide="list-filter" style="width: 18px; cursor: pointer;"></i>
            </div>
            <div class="orders-scroll">
                <!-- Exemplo de Item de Entrega -->
                <div class="order-item" onclick="focusDelivery(-23.5505, -46.6333)">
                    <div style="display: flex; justify-content: space-between; margin-bottom: 5px;">
                        <span style="font-weight: 600; font-size: 0.9rem;">#TRK-8829</span>
                        <span class="status-badge status-transit">Em Trânsito</span>
                    </div>
                    <div style="font-size: 0.85rem; color: var(--text-secondary);">
                        <i data-lucide="user" style="width: 12px; display: inline;"></i> João Silva
                    </div>
                    <div style="font-size: 0.8rem; color: var(--text-secondary); margin-top: 4px;">
                        Rua Augusta, 1200 - SP
                    </div>
                </div>

                <div class="order-item">
                    <div style="display: flex; justify-content: space-between; margin-bottom: 5px;">
                        <span style="font-weight: 600; font-size: 0.9rem;">#TRK-9012</span>
                        <span class="status-badge status-pending">Pendente</span>
                    </div>
                    <div style="font-size: 0.85rem; color: var(--text-secondary);">
                        <i data-lucide="user" style="width: 12px; display: inline;"></i> Maria Oliveira
                    </div>
                    <div style="font-size: 0.8rem; color: var(--text-secondary); margin-top: 4px;">
                        Av. Paulista, 500 - SP
                    </div>
                </div>
            </div>
        </aside>
    </div>
</div>

<!-- Script do Google Maps -->
<!-- Substitua YOUR_API_KEY pela sua chave real do Google Cloud Console -->
<script src="https://maps.googleapis.com/maps/api/js?key=YOUR_API_KEY&callback=initMap" async defer></script>
<script src="https://unpkg.com/lucide@latest"></script>

<script>
    let map;
    function initMap() {
        // Localização padrão (Ex: São Paulo)
        const defaultPos = { lat: -23.5505, lng: -46.6333 };
        
        map = new google.maps.Map(document.getElementById("map"), {
            zoom: 12,
            center: defaultPos,
            styles: [
                { "featureType": "poi", "stylers": [{ "visibility": "off" }] }
            ]
        });

        // Exemplo de marcador de motorista
        new google.maps.Marker({
            position: defaultPos,
            map: map,
            title: "Entregador 01",
            icon: 'https://maps.google.com/mapfiles/kml/pal2/icon47.png'
        });
    }

    function focusDelivery(lat, lng) {
        if (map) {
            map.setCenter({ lat, lng });
            map.setZoom(15);
        }
    }

    lucide.createIcons();
</script>