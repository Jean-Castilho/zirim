<style>
    :root {
        --bg-main: var(--cor-fundo-site, #f8f9fa);
        --bg-card: var(--cor-fundo-claro, #ffffff);
        --border-color: var(--cor-borda, #e9ecef);
        --text-primary: var(--cor-texto-escuro, #212529);
        --text-secondary: var(--cor-texto-medio, #495057);
        --accent-color: var(--cor-secundaria, #e10732);
        --success: var(--cor-sucesso, #2b8a3e);
        --warning: var(--cor-alerta, #e67e22);
        --info: #0ea5e9;
    }

    .delivery-container {
        background-color: var(--bg-main);
        font-family: 'Inter', sans-serif;
        padding: 2rem;
    }

    .delivery-layout {
        display: grid;
        grid-template-columns: 1fr 350px;
        gap: 2rem;
        max-width: 1600px;
        margin: 0 auto;
    }

    .map-view {
        background: var(--bg-card);
        border-radius: 16px;
        border: 1px solid var(--border-color);
        height: 600px;
        position: relative;
        overflow: hidden;
    }

    #map {
        height: 100%;
        width: 100%;
    }

    .map-overlay {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        z-index: 10;
        background: rgba(255, 255, 255, 0.85);
        backdrop-filter: blur(8px);
        padding: 1rem 1.25rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-bottom: 1px solid var(--border-color);
    }

    .orders-sidebar {
        background: var(--bg-card);
        border-radius: 16px;
        border: 1px solid var(--border-color);
        display: flex;
        flex-direction: column;
        max-height: 600px;
    }

    .panel-header {
        padding: 1.25rem;
        border-bottom: 1px solid var(--border-color);
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .panel-header h2 {
        font-size: 1.1rem;
        font-weight: 600;
        margin: 0;
        color: var(--text-primary);
    }

    .orders-list {
        overflow-y: auto;
        padding: 1rem;
    }

    .order-card {
        padding: 1rem;
        border-radius: 8px;
        border: 1px solid var(--border-color);
        margin-bottom: 0.75rem;
        cursor: pointer;
        transition: all 0.2s;
    }

    .order-card:hover {
        border-color: var(--accent-color);
        background: var(--cor-fundo-neutro, #f8f9fa);
    }

    .status-badge {
        font-size: 0.7rem;
        padding: 0.25rem 0.5rem;
        border-radius: 999px;
        text-transform: uppercase;
        font-weight: 700;
    }

    .status-transit { background: rgba(14, 165, 233, 0.1); color: var(--info); }
    .status-pending { background: rgba(230, 126, 34, 0.1); color: var(--warning); }

    @media (max-width: 1024px) {
        .delivery-layout {
            grid-template-columns: 1fr;
        }
        .map-view { height: 400px; }
        .delivery-container { padding: 1rem; }
    }
</style>

<main class="delivery-container">
    <div class="delivery-layout">
        <section class="map-view">
            <header class="map-overlay">
                <h2>Visualização em Tempo Real</h2>
                <button class="status-badge" style="border:1px solid var(--border-color); background: white; cursor: pointer;">
                    <i data-lucide="filter" style="width: 12px; vertical-align: middle;"></i> Filtros
                </button>
            </header>
            <div id="map"></div>
        </section>

        <aside class="orders-sidebar">
            <header class="panel-header">
                <h2>Entregas Ativas</h2>
                <i data-lucide="list-filter" style="width: 18px; cursor: pointer;"></i>
            </header>
            <div class="orders-list">
                <% if (activeOrders && activeOrders.length > 0) { %>
                    <% activeOrders.forEach(order => { %>
                        <article class="order-card" onclick="focusDelivery(<%= order.location?.lat || -23.5505 %>, <%= order.location?.lng || -46.6333 %>)">
                            <div style="display: flex; justify-content: space-between; margin-bottom: 5px;">
                                <span style="font-weight: 600; font-size: 0.9rem;">#<%= order._id.toString().slice(-6).toUpperCase() %></span>
                                <span class="status-badge <%= order.statusInterno === 'pago' ? 'status-transit' : 'status-pending' %>">
                                    <%= order.statusInterno === 'pago' ? 'Em Rota' : 'Aguard. Pgto' %>
                                </span>
                            </div>
                            <div style="font-size: 0.85rem; color: var(--text-secondary);">
                                <i data-lucide="user" style="width: 12px; display: inline;"></i> <%= order.user?.name || 'Cliente Zirim' %>
                            </div>
                            <div style="font-size: 0.8rem; color: var(--text-secondary); margin-top: 4px;">
                                Tel: <%= order.user?.phone || 'Não informado' %>
                            </div>
                        </article>
                    <% }) %>
                <% } else { %>
                    <div style="padding: 2rem; text-align: center; color: var(--text-secondary);">Nenhuma entrega ativa encontrada.</div>
                <% } %>
            </div>
        </aside>
    </div>
</main>

<!-- Script do Google Maps -->
<!-- Substitua YOUR_API_KEY pela sua chave real do Google Cloud Console -->
<script src="https://maps.googleapis.com/maps/api/js?key=YOUR_API_KEY&callback=initMap" async defer></script>
<script src="https://unpkg.com/lucide@latest"></script>

<script>
    let map;
    // Converte os dados do EJS para uso no JavaScript cliente
    const activeOrders = <%- JSON.stringify(activeOrders || []) %>;

    function initMap() {
        // Localização padrão (Ex: São Paulo)
        const defaultPos = { lat: -23.5505, lng: -46.6333 };
        
        map = new google.maps.Map(document.getElementById("map"), {
            zoom: 12,
            center: defaultPos,
            styles: [
                { "featureType": "poi", "stylers": [{ "visibility": "off" }] }
            ]
        });

        // Plota marcadores para cada pedido (usa posições aleatórias próximas se lat/lng não existir)
        activeOrders.forEach(order => {
            const pos = order.location || { 
                lat: -23.5505 + (Math.random() - 0.5) * 0.05, 
                lng: -46.6333 + (Math.random() - 0.5) * 0.05 
            };
            
            new google.maps.Marker({
                position: pos,
                map: map,
                title: `Pedido #${order._id}`,
                icon: order.statusInterno === 'pago' ? 'https://maps.google.com/mapfiles/ms/icons/green-dot.png' : 'https://maps.google.com/mapfiles/ms/icons/yellow-dot.png'
            });
        });
    }

    function focusDelivery(lat, lng) {
        if (map) {
            map.setCenter({ lat, lng });
            map.setZoom(15);
        }
    }

    lucide.createIcons();
</script>