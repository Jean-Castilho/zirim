<link rel="stylesheet" href="/css/pages/delivery.css">

<main class="delivery-container">
    <aside class="delivery-sidebar">
        <header class="panel-header">
            <div class="panel-header-title">
                <h2>Entregas Ativas</h2>
                <span class="orders-count-badge" id="orders-count"><%= (activeOrders && activeOrders.length) || 0 %></span>
            </div>
            <div class="panel-actions" style="display: flex; gap: 6px;">
                <a href="/delivery/courier" class="btn-icon" title="Abrir Painel do Entregador" style="display: inline-flex; align-items: center; justify-content: center; text-decoration: none; color: inherit;">
                    <i data-lucide="truck" style="width: 16px; height: 16px;"></i>
                </a>
                <button type="button" class="btn-icon" title="Recentralizar entregas" onclick="fitAllDeliveries()">
                    <i data-lucide="maximize-2" style="width: 16px; height: 16px;"></i>
                </button>
            </div>
        </header>

        <div class="sidebar-search">
            <div class="search-input-wrapper">
                <i data-lucide="search" class="search-icon"></i>
                <input type="text" id="order-search" placeholder="Buscar por cliente, pedido ou rua..." oninput="filterOrders(this.value)">
            </div>
        </div>

        <div class="orders-list" id="orders-list">
            <% if (activeOrders && activeOrders.length > 0) { %>
                <% activeOrders.forEach(order => { 
                    const orderShortId = order._id ? order._id.toString().slice(-6).toUpperCase() : '------';
                    const lat = order.location?.lat != null && Number.isFinite(Number(order.location.lat)) ? Number(order.location.lat) : 'null';
                    const lng = order.location?.lng != null && Number.isFinite(Number(order.location.lng)) ? Number(order.location.lng) : 'null';
                    const clientName = order.user?.name || 'Cliente Zirim';
                    const rawPhone = order.user?.phone;
                    const clientPhone = (typeof rawPhone === 'object' ? rawPhone?.number : rawPhone) || 'Não informado';
                    const street = order.address?.street || '';
                    const neighborhood = order.address?.neighborhood ? `, ${order.address.neighborhood}` : '';
                    const cep = order.address?.cep ? ` (CEP: ${order.address.cep})` : '';
                    const fullAddress = street ? `${street}${neighborhood}${cep}` : 'Endereço não informado';
                    const status = order.statusInterno || 'pendente';
                    const courierName = order.delivery?.courierName || '';
                %>
                    <article 
                        class="order-card" 
                        id="order-card-<%= order._id %>"
                        data-search="<%= (orderShortId + ' ' + clientName + ' ' + fullAddress + ' ' + courierName).toLowerCase() %>"
                        onclick="focusDelivery(<%= lat %>, <%= lng %>, '<%= order._id %>')"
                    >
                        <div class="order-card-header">
                            <div class="order-card-id">
                                <i data-lucide="package" class="icon-sm"></i>
                                <span>#<%= orderShortId %></span>
                            </div>
                            <span class="status-badge <%= status === 'em_rota' ? 'status-transit' : (status === 'preparado' ? 'status-pending' : 'status-transit') %>">
                                <span class="status-dot"></span>
                                <%= status === 'em_rota' ? 'Em Rota' : (status === 'preparado' ? 'Pronto' : (status === 'pago' ? 'Pago' : 'Aguard. Pgto')) %>
                            </span>
                        </div>

                        <div class="order-card-body">
                            <div class="order-info-row">
                                <i data-lucide="user" class="icon-sm"></i>
                                <span class="client-name"><%= clientName %></span>
                            </div>
                            <% if (courierName) { %>
                                <div class="order-info-row" style="color: #0284c7;">
                                    <i data-lucide="truck" class="icon-sm"></i>
                                    <span>Entregador: <strong><%= courierName %></strong></span>
                                </div>
                            <% } %>
                            <div class="order-info-row">
                                <i data-lucide="phone" class="icon-sm"></i>
                                <span><%= clientPhone %></span>
                            </div>
                            <div class="order-info-row address-row">
                                <i data-lucide="map-pin" class="icon-sm pin-icon"></i>
                                <span><%= fullAddress %></span>
                            </div>
                        </div>
                    </article>
                <% }) %>
            <% } else { %>
                <div class="empty-orders-state">
                    <div class="empty-icon-wrap">
                        <i data-lucide="package-check" style="width: 28px; height: 28px;"></i>
                    </div>
                    <h3>Sem entregas ativas</h3>
                    <p>Todos os pedidos com entrega pendente ou em rota serão exibidos aqui em tempo real.</p>
                </div>
            <% } %>
        </div>
    </aside>

    <section class="delivery-map-container delivery-map">
        <div class="map-live-indicator">
            <span class="live-dot"></span>
            <span>Monitoramento em Tempo Real</span>
        </div>
        <div id="map"></div>
    </section>
</main>

<script src="https://maps.googleapis.com/maps/api/js?key=<%= mapApiKey %>"></script>
<script src="https://unpkg.com/lucide@latest"></script>

<script>
    let map;
    let bounds;
    let activeInfoWindow = null;
    const markersMap = {};
    const activeOrders = <%- JSON.stringify(activeOrders || []).replace(/</g, '\\u003c') %>;
    const defaultPosition = { lat: -23.5505, lng: -46.6333 };

    function escapeHtml(text) {
        const div = document.createElement('div');
        div.textContent = text || '';
        return div.innerHTML;
    }

    function initMap() {
        if (typeof google === 'undefined' || !google.maps) {
            const mapEl = document.getElementById('map');
            if (mapEl) {
                mapEl.innerHTML = `
                    <div style="display:flex;flex-direction:column;align-items:center;justify-content:center;height:100%;color:#6c757d;text-align:center;padding:2rem;">
                        <p style="font-weight:600;margin-bottom:0.5rem;">Não foi possível carregar o Google Maps.</p>
                        <small>Verifique se a variável GOOGLE_API_KEY está configurada no seu ambiente.</small>
                    </div>
                `;
            }
            return;
        }

        map = new google.maps.Map(document.getElementById('map'), {
            center: defaultPosition,
            zoom: 12,
            mapTypeControl: false,
            streetViewControl: false,
            fullscreenControl: false,
            zoomControl: true
        });

        bounds = new google.maps.LatLngBounds();
        let validCount = 0;

        activeOrders.forEach(order => {
            const lat = Number(order.location?.lat);
            const lng = Number(order.location?.lng);
            if (!Number.isFinite(lat) || !Number.isFinite(lng) || Math.abs(lat) > 90 || Math.abs(lng) > 180) return;

            const position = { lat, lng };
            bounds.extend(position);
            validCount++;

            const orderShortId = order._id ? String(order._id).slice(-6).toUpperCase() : '------';
            const clientName = order.user?.name || 'Cliente Zirim';
            const street = order.address?.street || '';
            const neighborhood = order.address?.neighborhood ? `, ${order.address.neighborhood}` : '';
            const cep = order.address?.cep ? ` (CEP: ${order.address.cep})` : '';
            const fullAddress = street ? `${street}${neighborhood}${cep}` : 'Endereço não informado';
            const orderStatus = order.statusInterno || 'pendente';
            const courierName = order.delivery?.courierName || '';
            const statusLabel = orderStatus === 'em_rota' ? 'Em Rota' : (orderStatus === 'preparado' ? 'Pronto' : (orderStatus === 'pago' ? 'Pago' : 'Aguard. Pgto'));
            const badgeClass = orderStatus === 'em_rota' ? 'status-transit' : (orderStatus === 'preparado' ? 'status-pending' : 'status-transit');

            const marker = new google.maps.Marker({
                position,
                map,
                title: `Pedido #${orderShortId} - ${clientName}`
            });

            const infoWindow = new google.maps.InfoWindow({
                content: `
                    <div class="map-popup-card">
                        <header>
                            <strong>#${orderShortId}</strong>
                            <span class="status-badge ${badgeClass}">
                                ${statusLabel}
                            </span>
                        </header>
                        <div style="font-size: 0.85rem; color: #212529;">
                            <p style="margin: 0 0 4px 0; font-weight: 600;">${escapeHtml(clientName)}</p>
                            <p style="margin: 0; color: #6c757d;">${escapeHtml(fullAddress)}</p>
                            ${courierName ? `<p style="margin: 6px 0 0 0; font-size: 0.8rem; color: #0284c7;"><strong>Entregador:</strong> ${escapeHtml(courierName)}</p>` : ''}
                        </div>
                    </div>
                `
            });

            marker.addListener('click', () => {
                if (activeInfoWindow) activeInfoWindow.close();
                infoWindow.open(map, marker);
                activeInfoWindow = infoWindow;
                highlightCard(order._id);
            });

            markersMap[order._id] = { marker, infoWindow, position };
        });

        if (validCount > 0) {
            if (validCount === 1) {
                map.setCenter(bounds.getCenter());
                map.setZoom(15);
            } else {
                map.fitBounds(bounds, { top: 40, right: 40, bottom: 40, left: 40 });
            }
        }
    }

    function highlightCard(orderId) {
        document.querySelectorAll('.order-card').forEach(card => card.classList.remove('is-selected'));
        if (!orderId) return;
        const selectedCard = document.getElementById(`order-card-${orderId}`);
        if (selectedCard) {
            selectedCard.classList.add('is-selected');
            selectedCard.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        }
    }

    function focusDelivery(lat, lng, orderId) {
        if (!Number.isFinite(lat) || !Number.isFinite(lng)) {
            highlightCard(orderId);
            return;
        }
        if (!map) return;

        map.panTo({ lat, lng });
        map.setZoom(16);

        if (orderId && markersMap[orderId]) {
            if (activeInfoWindow) activeInfoWindow.close();
            const { marker, infoWindow } = markersMap[orderId];
            infoWindow.open(map, marker);
            activeInfoWindow = infoWindow;
        }

        highlightCard(orderId);
    }

    function fitAllDeliveries() {
        if (!map || !bounds || bounds.isEmpty()) return;
        map.fitBounds(bounds, { top: 40, right: 40, bottom: 40, left: 40 });
    }

    function filterOrders(query) {
        const term = (query || '').trim().toLowerCase();
        const cards = document.querySelectorAll('.order-card');
        let visibleCount = 0;

        cards.forEach(card => {
            const text = card.getAttribute('data-search') || '';
            const orderId = card.id.replace('order-card-', '');
            const isMatch = !term || text.includes(term);

            card.style.display = isMatch ? 'flex' : 'none';

            if (markersMap[orderId]) {
                markersMap[orderId].marker.setVisible(isMatch);
            }

            if (isMatch) visibleCount++;
        });

        const countBadge = document.getElementById('orders-count');
        if (countBadge) {
            countBadge.textContent = visibleCount;
        }
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', () => {
            initMap();
            lucide.createIcons();
        });
    } else {
        initMap();
        lucide.createIcons();
    }
</script>