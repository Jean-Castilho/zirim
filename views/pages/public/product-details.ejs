<link rel="stylesheet" href="/css/pages/product-details.css">

<section class="product-details-page" data-product-id="<%= product._id %>">
  <div class="product-details-container">

    <!-- Galeria de imagens -->
    <div class="product-gallery">
      <div class="main-image-container skeleton">
        <img id="mainImage" class="main-image is-loading" src="/img/placeholder-product.svg" alt="Carregando...">
        <span class="stock-badge skeleton" id="stockBadgeDisplay">Carregando</span>
      </div>
      <div class="gallery-thumbnails skeleton" id="galleryThumbnails"></div>
    </div>

    <!-- Informações do produto -->
    <div class="product-info">
      <div class="breadcrumb">
        <a href="/products">Produtos</a> / <span id="breadcrumbCategory" class="skeleton">Categoria</span>
      </div>

      <h1 class="product-title skeleton" id="productTitle">Nome do Produto</h1>

      <div class="price-section">
        <div class="price skeleton" id="productPriceContainer">
          <span class="currency">R$</span>
          <span class="amount" id="productAmount">0,00</span>
        </div>
        <p class="price-note">Preço sujeito a alterações</p>
      </div>

      <div class="specifications">
        <h3>Especificações</h3>
        <div class="spec-item">
          <span class="spec-label">Categoria:</span>
          <span class="spec-value skeleton" id="specCategory">Carregando...</span>
        </div>
        <div class="spec-item">
          <span class="spec-label">Estoque:</span>
          <span class="spec-value skeleton" id="specStock">0 unidades</span>
        </div>
      </div>

      <div class="selectors">
        <div class="variation-section" id="colorSelectorSection" hidden>
          <label for="colorPillSelector">Cor:</label>
          <div class="pill-selector" id="colorPillSelector"></div>
          <div id="colorError" class="validation-error" hidden>Selecione uma cor</div>
        </div>

        <div class="variation-section" id="sizeSelectorSection" hidden>
          <label for="sizePillSelector">Tamanho:</label>
          <div class="pill-selector" id="sizePillSelector"></div>
          <div id="sizeError" class="validation-error" hidden>Selecione um tamanho</div>
        </div>

        <div class="quantity-section">
          <div class="quantity-control">
            <button type="button" id="decreaseQtyBtn" class="qty-btn" aria-label="Diminuir quantidade" disabled>-</button>
            <input type="number" id="quantity" value="0" min="0" max="0" aria-label="Quantidade" readonly>
            <button type="button" id="increaseQtyBtn" class="qty-btn" aria-label="Aumentar quantidade" disabled>+</button>
          </div>
        </div>
      </div>

      <div class="action-buttons">
        <button type="button" id="addToCartButton" class="btn-primary" disabled>
          <i class="material-icons" aria-hidden="true">shopping_cart</i>
          Adicionar ao carrinho
        </button>
      </div>

      <p id="productError" class="validation-error" role="alert" hidden>
        Não foi possível carregar as informações do produto.
        <a href="" class="retry-link">Tentar novamente</a>
      </p>

      <!-- Garantias -->
      <div class="guarantee-section">
        <div class="guarantee-item">
          <i class="material-icons" aria-hidden="true">local_shipping</i>
          <div>
            <strong>Frete Grátis</strong>
            <p>Em compras acima de R$ 100</p>
          </div>
        </div>
        <div class="guarantee-item">
          <i class="material-icons" aria-hidden="true">verified_user</i>
          <div>
            <strong>Garantia</strong>
            <p>12 meses de cobertura</p>
          </div>
        </div>
        <div class="guarantee-item">
          <i class="material-icons" aria-hidden="true">undo</i>
          <div>
            <strong>Devolução</strong>
            <p>30 dias para trocar</p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="expanded-description">
    <h2>Sobre este Produto</h2>
    <p id="productDescription" class="skeleton">Carregando descrição detalhada do produto...</p>
  </div>
</section>

<script src="/js/product-details.js"></script>
