<header class="header">
  <nav class="navbar">

    <a href="/" class="nav-logo">ZIRIM</a>

    <ul class="nav-menu">
      <li><a href="/" class="nav-link <%= currentPath === '/' ? 'active' : '' %>">Home</a>
      </li>
      <li><a href="/products" class="nav-link <%= isActive('/products') ? 'active' : '' %>">Produtos</a>
      </li>

      <% if (user) { %>
        <li><a href="/contact" class="nav-link <%= isActive('/contact') ? 'active' : '' %>">Contato</a>
        </li>
        <% } %>
          <!-- Ícones ficam dentro do menu (o carrinho fica fora, em .header-actions) -->
          <li class="header-icons-container">
            <div class="header-icons">
              <% if (user) { %>
                <a href="/profile" class="nav-link <%= isActive('/profile') ? 'active' : '' %>"
                  aria-label="Perfil do Usuário">
                  <span class="material-icons notranslate md-22">person</span>
                </a>

                <% if (user.role==='admin' ) { %>
                  <a href="/dashboard" class="nav-link <%= isActive('/dashboard') ? 'active' : '' %>"
                    aria-label="Painel do Administrador">
                    <span class="material-icons notranslate md-22">admin_panel_settings</span>
                  </a>
                  <% } %>

                    <% if (user.role==='entregador' || user.role==='delivery' || user.role==='admin' ) { %>
                      <a href="<%= user.role==='admin' ? '/delivery' : '/delivery/courier' %>" class="nav-link <%= isActive('/delivery') ? 'active' : '' %>"
                        aria-label="<%= user.role==='admin' ? 'Monitoramento de Entregas' : 'Painel do Entregador' %>"
                        title="<%= user.role==='admin' ? 'Monitoramento de Entregas' : 'Painel do Entregador' %>">
                        <span class="material-icons notranslate md-22">local_shipping</span>
                      </a>
                      <% } %>

                        <% if (user.role==='staff' || user.role==='admin' ) { %>
                          <a href="/inventory" class="nav-link <%= isActive('/inventory') ? 'active' : '' %>"
                            aria-label="Estoque">
                            <span class="material-icons notranslate md-22">inventory</span>
                          </a>
                          <% } %>

                            <form method="post" action="/logout" hx-boost="false" class="logout-form">
                              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                              <button type="submit" class="nav-link logout-button" aria-label="Sair">
                                <span class="material-icons notranslate md-22">logout</span>
                              </button>
                            </form>
                            <% } else { %>
                              <a href="/login" class="nav-link <%= isActive('/login') ? 'active' : '' %>"
                                aria-label="Login">
                                <span class="material-icons notranslate md-22">person</span>
                              </a>
                              <a href="/pedidos" class="nav-link <%= isActive('/pedidos') ? 'active' : '' %>"
                                aria-label="Meus Pedidos" title="Meus Pedidos">
                                <span class="material-icons notranslate md-22">receipt_long</span>
                              </a>
                              <% } %>
                                <a href="/favorites" class="nav-link <%= isActive('/favorites') ? 'active' : '' %>"
                                  aria-label="Meus Favoritos">
                                  <span class="material-icons notranslate md-22">favorite_border</span>
                                </a>
            </div>
          </li>
    </ul>

    <!-- Carrinho e hambúrguer ficam sempre visíveis na barra (inclusive no celular) -->
    <div class="header-actions">
      <a href="/cart" class="nav-link nav-cart <%= isActive('/cart') ? 'active' : '' %>"
        aria-label="Meu Carrinho">
        <span class="material-icons notranslate md-22">shopping_cart</span>
        <span id="cart-badge" class="cart-badge">0</span>
      </a>

      <div class="hamburger" role="button" tabindex="0" aria-label="Abrir menu" aria-expanded="false">
        <span class="bar"></span>
        <span class="bar"></span>
        <span class="bar"></span>
      </div>
    </div>
  </nav>

  <div class="nav-overlay"></div>

</header>
<script src="/js/cart-storage.js"></script>
<script src="/js/guest-orders.js"></script>
<script src="/js/header.js"></script>
