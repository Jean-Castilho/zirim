<link rel="stylesheet" href="/css/pages/tabela-product.css">
<div class="admin-container">
  
  <header class="admin-header">
    <div>
      <h1 class="admin-title"><%= titulo %></h1>
    </div>
    <div>
      <a href="/inventory/add" class="btn-add">
        <i class="material-icons">add</i> Adicionar Produto
      </a>
    </div>
  </header>

  <div class="table-responsive">
    <table class="admin-table">
      <thead>
        <tr>
          <th>Imagem</th>
          <th>Nome do Produto</th>
          <th>Categoria</th>
          <th>Preço (R$)</th>
          <th>Estoque</th>
          <th class="text-center">Ações</th>
        </tr>
      </thead>
      <tbody>
        <% if (products && products.length > 0) { %>
          <% products.forEach(product => { %>
            <tr>
              
              <td class="text-center">
                <img class="table-image" 
                     src="<%= product.variacoes?.[0]?.imagens?.[0] ? '/image/' + product.variacoes[0].imagens[0] : 'https://via.placeholder.com/40' %>" 
                     alt="<%= product.nome %>">
              </td>

              <td><%= product.nome %></td>
              
              <td class="col-categoria"><%= product.categoria %></td>
              
              <td class="col-preco"><%= product.variacoes?.[0]?.preco || '0.00' %></td>
              
              <td>
                <!-- Lógica de EJS injetando a classe CSS correta baseada na quantidade de estoque da variação principal -->
                <span class="stock-badge <%= product.variacoes?.[0]?.estoque > 6 ? 'stock-high' : 'stock-low' %>">
                  <%= product.variacoes?.[0]?.estoque || 0 %>
                </span>
              </td>
              
              <td class="text-center">
                <div class="actions-wrapper">
                  <a href="/inventory/edit/<%= product._id %>" title="Editar" class="btn-icon btn-edit u-text-decoration-none">
                    <i class="material-icons">edit</i>
                  </a>
                  <button type="button" 
                          title="Excluir" 
                          class="btn-icon btn-delete"
                          hx-headers='{"x-csrf-token":"<%= csrfToken %>"}'
                          hx-delete="/products/<%= product._id %>"
                          hx-trigger="click"
                          hx-target="closest tr"
                          hx-swap="outerHTML swap:0.5s"
                          hx-confirm="Tem certeza que deseja remover o produto '<%= product.nome %>'?">
                    <i class="material-icons">delete</i>
                  </button>
                </div>
              </td>

            </tr>
          <% }) %>
        <% } else { %>
          <tr>
            <td colspan="6" class="empty-state-cell">
              <i class="material-icons">inventory_2</i>
              Nenhum produto cadastrado no inventário.
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
  
  <div class="back-link-wrapper">
    <a href="/dashboard" class="back-link">
      <i class="material-icons u-font-size-18px">arrow_back</i> Voltar ao Painel
    </a>
  </div>
</div>