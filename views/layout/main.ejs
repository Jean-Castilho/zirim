<!DOCTYPE html>
<%
  // As views declaram seus próprios <link rel="stylesheet"> no topo do arquivo.
  // Se eles ficarem dentro do <main>, o navegador já pinta o <body> sem CSS e
  // depois aplica o estilo (FOUC). Aqui os movemos para o <head>, para que o CSS
  // da página esteja carregado antes da primeira pintura.
  const STYLESHEET_LINK_RE = /<link\b[^>]*rel=["']stylesheet["'][^>]*>/gi;
  const pageHtml = include(page);
  const pageStyleLinks = pageHtml.match(STYLESHEET_LINK_RE) || [];
  const pageBodyHtml = pageHtml.replace(STYLESHEET_LINK_RE, '');
%>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= locals.titulo ? titulo + ' | ' + storeName : storeName %></title>
    <meta name="store-name" content="<%= storeName %>">
    <script src="/js/core/store.js"></script>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
    <link rel="stylesheet" href="/css/main.css">
    <link rel="stylesheet" href="/css/utilities.css">
    <link rel="stylesheet" href="/css/components/dialog.css">

    <% if (locals.pageStyles && Array.isArray(pageStyles)) { %>
        <% pageStyles.forEach(function(styleSheet) { %>
            <link rel="stylesheet" href="/css/pages/<%= styleSheet %>.css">
        <% }); %>
    <% } %>
    <%- pageStyleLinks.join('\n    ') %>

    <script src="/js/core/ready.js"></script>
</head>

<body hx-boost="true" hx-target="#main-content" hx-push-url="true" hx-swap="innerHTML">
    <div id="notification-container"></div>
    <%- include('../pages/partials/header') %>
    <main id="main-content">
        <%- pageBodyHtml %>
    </main>
    <script src="https://unpkg.com/htmx.org@2.0.4"></script>
    <script src="/js/core/dialog.js"></script>
    <script src="/js/core/http.js"></script>
    <script src="/js/main.js"></script>
</body>
</html>